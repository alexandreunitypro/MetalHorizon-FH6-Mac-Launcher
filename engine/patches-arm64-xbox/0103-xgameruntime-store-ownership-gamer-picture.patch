+    case XAsyncOp_GetResult:
+        memcpy( data->buffer, req->data, req->size );
+        return S_OK;
+    case XAsyncOp_Cleanup:
+        picture_request_free( req );
+        return S_OK;
+    default:
+        return S_OK;
