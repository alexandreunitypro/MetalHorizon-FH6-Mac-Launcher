+/* GSDX: the gamer picture the service fetched from the player's Xbox profile, a PNG; status 1 means none. */
+static NTSTATUS gamer_picture( void *args )
+{
+    struct gamer_picture_params *params = args;
+    UINT32 request[3] = { 0x58445347, 1, 0 }, answer[3];
+    long long deadline = license_now_ms() + 30000;
+    NTSTATUS status = STATUS_UNSUCCESSFUL;
+    int fd;
+
+    params->size = 0;
+    if (!params->buffer) return STATUS_INVALID_PARAMETER;
+    request[2] = params->pixels;
+    if ((fd = connect_service( deadline )) < 0) return io_status( STATUS_NOT_FOUND );
+    errno = 0;
+    if (!license_io( fd, request, sizeof(request), TRUE, deadline ) ||
+        !license_io( fd, answer, sizeof(answer), FALSE, deadline ))
+    { status = io_status( STATUS_UNSUCCESSFUL ); goto done; }
+    if (answer[0] != 0x58445347 || answer[1] != 0 || !answer[2] || answer[2] > XGR_PICTURE_MAX) goto done;
+    if (!license_io( fd, params->buffer, answer[2], FALSE, deadline ))
+    { status = io_status( STATUS_UNSUCCESSFUL ); goto done; }
+    params->size = answer[2];
+    status = STATUS_SUCCESS;
+done:
+    close( fd );
     return status;
 }
 
