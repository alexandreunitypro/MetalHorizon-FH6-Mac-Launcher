+#define PICTURE_RETRY_MS 60000
+
+struct picture_request
+{
+    struct gamer_picture_params params;
+    XAsyncBlock *async;                /* set when DoWork hands the request off */
+    const BYTE *data;
+    SIZE_T size;
+};
+
+static const char gamer_picture_identity;
+static volatile ULONGLONG picture_failed_at;   /* GetTickCount64() of the last failure; 0: none */
+
+static UINT32 picture_pixels( XUserGamerPictureSize size )
+{
+    switch (size)
+    {
+    case XUserGamerPictureSize_Small: return 64;
+    case XUserGamerPictureSize_Medium: return 208;
+    case XUserGamerPictureSize_Large: return 424;
+    case XUserGamerPictureSize_ExtraLarge: return 1080;
+    default: return 208;
+    }
+}
+
+static void picture_request_free( struct picture_request *req )
+{
+    free( req->params.buffer );
+    free( req );
+}
+
+static void picture_request_run( struct picture_request *req )
+{
+    ULONGLONG failed = picture_failed_at, now = GetTickCount64();
+    NTSTATUS status = STATUS_RETRY;
+    void *shrunk;
+
+    if (!failed || now - failed >= PICTURE_RETRY_MS)
+    {
+        if (!(req->params.buffer = malloc( XGR_PICTURE_MAX ))) status = STATUS_NO_MEMORY;
+        else status = XGR_UNIX_CALL( gamer_picture, &req->params );
+        if (!status && req->params.size && req->params.size <= XGR_PICTURE_MAX)
+        {
+            if ((shrunk = realloc( req->params.buffer, req->params.size ))) req->params.buffer = shrunk;
+            req->data = req->params.buffer;
+            req->size = req->params.size;
+            picture_failed_at = 0;
+            TRACE( "the account's gamer picture: %u px, %lu bytes.\n", req->params.pixels, req->params.size );
+        }
+        else
+        {
+            picture_failed_at = now | 1;
+            WARN( "no gamer picture from the Xbox profile (%#lx); the plain one stands in.\n", status );
+        }
+    }
+    if (!req->data)
+    {
+        req->data = gamer_picture_png;
+        req->size = sizeof(gamer_picture_png);
+    }
+    /* Completion may release the request on another thread: the last use. */
+    IXThreadingImpl_XAsyncComplete( x_threading_impl, req->async, S_OK, req->size );
+}
 
+static void CALLBACK picture_request_detached( TP_CALLBACK_INSTANCE *instance, void *context )
+{
+    picture_request_run( context );
+}
+
+static HRESULT CALLBACK picture_provider( XAsyncOp op, const XAsyncProviderData *data )
+{
+    struct picture_request *req = data->context;
+    HRESULT hr;
+
+    switch (op)
