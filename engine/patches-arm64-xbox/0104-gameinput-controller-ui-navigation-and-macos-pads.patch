+/* One pad's state, in XInput's terms: XINPUT_GAMEPAD_* buttons (0x0400 the guide, the PS or Home button), triggers
+ * from 0 to 1 and sticks from -1 to 1, up positive. `handle` names the pad for as long as it stays connected. */
+struct apple_pad
+{
+    UINT64 handle;
+    UINT32 buttons;
+    float left_trigger, right_trigger;
+    float left_x, left_y, right_x, right_y;
+    char name[64];
+    char category[32];
+};
+
+struct apple_pads_params
+{
+    UINT32 count;
+    struct apple_pad pads[APPLE_PADS_MAX];
+};
