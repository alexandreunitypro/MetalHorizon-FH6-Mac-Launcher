+    if (reading->device->type != DEVICE_GAMEPAD || !state || !count) return zero_count( count, state, sizeof(*state) );
+    state[0] = dpad_position( reading->gamepad.buttons );
+    for (i = 1; i < count; i++) state[i] = GameInputSwitchCenter;
