+/*
+ * GameInput's Unix side: the pads macOS itself knows, read through GameController.framework
+ *
+ * Copyright 2026 MetalHorizon contributors
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Wine's HID bus runs in winedevice.exe, a process with no Cocoa run loop, and there SDL's macOS joystick driver,
+ * which needs one, sees no pad over Bluetooth: a DualSense paired with the Mac reached no game (MetalHorizon issue
+ * #15). The game's own process runs Cocoa's main loop (winemac.drv), so GameController.framework works in it. This
+ * reads the extended gamepad profile of every pad macOS knows, DualSense, DualShock 4, Xbox, Switch Pro and MFi pads
+ * alike, on Bluetooth as on a cable. The framework is loaded at run time and messaged through the Objective-C
+ * runtime's C interface, so nothing here is linked against it: where it cannot load, there are simply no pads.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+
+#include "unixlib.h"
+
+#ifdef __APPLE__
+
+#include <dlfcn.h>
+#include <pthread.h>
+
+typedef struct objc_object *id;
+typedef struct objc_selector *SEL;
+typedef signed char objc_bool;
+
+static id (*p_objc_getClass)( const char *name );
+static SEL (*p_sel_registerName)( const char *name );
+static void *p_objc_msgSend;
+static void *(*p_objc_autoreleasePoolPush)( void );
+static void (*p_objc_autoreleasePoolPop)( void *pool );
+static id controller_class;
+static pthread_once_t init_once = PTHREAD_ONCE_INIT;
+
+static struct
+{
+    SEL controllers, count, objectAtIndex, respondsToSelector, extendedGamepad, vendorName, productCategory, UTF8String;
+    SEL leftThumbstick, rightThumbstick, dpad, xAxis, yAxis, up, down, left, right, value, isPressed;
+    SEL buttonA, buttonB, buttonX, buttonY, leftShoulder, rightShoulder, leftTrigger, rightTrigger;
+    SEL buttonMenu, buttonOptions, buttonHome, leftThumbstickButton, rightThumbstickButton;
+} sel;
+
+static void load_framework( void )
+{
+    void *objc, *framework;
+
+    if (!(framework = dlopen( "/System/Library/Frameworks/GameController.framework/GameController", RTLD_LAZY | RTLD_LOCAL )))
+        return;
+    if (!(objc = dlopen( "/usr/lib/libobjc.A.dylib", RTLD_LAZY | RTLD_LOCAL ))) return;
+    p_objc_getClass = dlsym( objc, "objc_getClass" );
+    p_sel_registerName = dlsym( objc, "sel_registerName" );
+    p_objc_msgSend = dlsym( objc, "objc_msgSend" );
+    p_objc_autoreleasePoolPush = dlsym( objc, "objc_autoreleasePoolPush" );
+    p_objc_autoreleasePoolPop = dlsym( objc, "objc_autoreleasePoolPop" );
+    if (!p_objc_getClass || !p_sel_registerName || !p_objc_msgSend || !p_objc_autoreleasePoolPush ||
+        !p_objc_autoreleasePoolPop)
+        return;
+
+#define SELECTOR( field, name ) sel.field = p_sel_registerName( name )
+    SELECTOR( controllers, "controllers" );
+    SELECTOR( count, "count" );
+    SELECTOR( objectAtIndex, "objectAtIndex:" );
+    SELECTOR( respondsToSelector, "respondsToSelector:" );
+    SELECTOR( extendedGamepad, "extendedGamepad" );
+    SELECTOR( vendorName, "vendorName" );
+    SELECTOR( productCategory, "productCategory" );
+    SELECTOR( UTF8String, "UTF8String" );
+    SELECTOR( leftThumbstick, "leftThumbstick" );
+    SELECTOR( rightThumbstick, "rightThumbstick" );
+    SELECTOR( dpad, "dpad" );
+    SELECTOR( xAxis, "xAxis" );
+    SELECTOR( yAxis, "yAxis" );
+    SELECTOR( up, "up" );
+    SELECTOR( down, "down" );
+    SELECTOR( left, "left" );
+    SELECTOR( right, "right" );
+    SELECTOR( value, "value" );
+    SELECTOR( isPressed, "isPressed" );
+    SELECTOR( buttonA, "buttonA" );
+    SELECTOR( buttonB, "buttonB" );
+    SELECTOR( buttonX, "buttonX" );
+    SELECTOR( buttonY, "buttonY" );
+    SELECTOR( leftShoulder, "leftShoulder" );
+    SELECTOR( rightShoulder, "rightShoulder" );
+    SELECTOR( leftTrigger, "leftTrigger" );
+    SELECTOR( rightTrigger, "rightTrigger" );
+    SELECTOR( buttonMenu, "buttonMenu" );
+    SELECTOR( buttonOptions, "buttonOptions" );
+    SELECTOR( buttonHome, "buttonHome" );
+    SELECTOR( leftThumbstickButton, "leftThumbstickButton" );
+    SELECTOR( rightThumbstickButton, "rightThumbstickButton" );
+#undef SELECTOR
+    controller_class = p_objc_getClass( "GCController" );
+}
+
+/* Messages, each to an object that may be nil, and to a selector it may not answer (an older macOS): an Objective-C
+ * object raises an exception for a selector it does not know, which nothing here would catch. */
+static objc_bool answers( id obj, SEL selector )
+{
+    return obj && ((objc_bool (*)( id, SEL, SEL ))p_objc_msgSend)( obj, sel.respondsToSelector, selector );
+}
+
+static id message( id obj, SEL selector )
+{
+    return answers( obj, selector ) ? ((id (*)( id, SEL ))p_objc_msgSend)( obj, selector ) : NULL;
+}
+
+static float message_float( id obj, SEL selector )
+{
+    return answers( obj, selector ) ? ((float (*)( id, SEL ))p_objc_msgSend)( obj, selector ) : 0.0f;
+}
+
+static BOOL pressed( id button )
+{
+    return answers( button, sel.isPressed ) && ((objc_bool (*)( id, SEL ))p_objc_msgSend)( button, sel.isPressed );
+}
+
+static float clamp( float value, float low, float high )
+{
+    if (!(value >= low)) return low; /* NaN too */
+    return value > high ? high : value;
+}
+
+static void copy_string( char *dst, size_t size, id string )
+{
+    const char *utf8 = answers( string, sel.UTF8String ) ? ((const char *(*)( id, SEL ))p_objc_msgSend)( string, sel.UTF8String ) : NULL;
+    dst[0] = 0;
+    if (!utf8) return;
+    strncpy( dst, utf8, size - 1 );
+    dst[size - 1] = 0;
+}
+
+static void read_pad( id controller, id gamepad, struct apple_pad *pad )
+{
+    static const struct { SEL *selector; UINT32 bit; } buttons[] =
+    {
+        { &sel.buttonA, 0x1000 }, { &sel.buttonB, 0x2000 }, { &sel.buttonX, 0x4000 }, { &sel.buttonY, 0x8000 },
+        { &sel.leftShoulder, 0x0100 }, { &sel.rightShoulder, 0x0200 },
+        { &sel.buttonMenu, 0x0010 },            /* Start: Options on a PlayStation pad, + on a Switch pad */
+        { &sel.buttonOptions, 0x0020 },         /* Back: Create or Share, - */
+        { &sel.leftThumbstickButton, 0x0040 }, { &sel.rightThumbstickButton, 0x0080 },
+        { &sel.buttonHome, 0x0400 },            /* the guide: PS, Home, Xbox */
+    };
+    id dpad = message( gamepad, sel.dpad ), left = message( gamepad, sel.leftThumbstick ), right = message( gamepad, sel.rightThumbstick );
+    unsigned int i;
+
+    memset( pad, 0, sizeof(*pad) );
+    pad->handle = (UINT64)(ULONG_PTR)controller;
+    for (i = 0; i < sizeof(buttons) / sizeof(buttons[0]); i++)
+        if (pressed( message( gamepad, *buttons[i].selector ) )) pad->buttons |= buttons[i].bit;
+    if (pressed( message( dpad, sel.up ) )) pad->buttons |= 0x0001;
+    if (pressed( message( dpad, sel.down ) )) pad->buttons |= 0x0002;
+    if (pressed( message( dpad, sel.left ) )) pad->buttons |= 0x0004;
+    if (pressed( message( dpad, sel.right ) )) pad->buttons |= 0x0008;
+    pad->left_trigger = clamp( message_float( message( gamepad, sel.leftTrigger ), sel.value ), 0.0f, 1.0f );
+    pad->right_trigger = clamp( message_float( message( gamepad, sel.rightTrigger ), sel.value ), 0.0f, 1.0f );
+    pad->left_x = clamp( message_float( message( left, sel.xAxis ), sel.value ), -1.0f, 1.0f );
+    pad->left_y = clamp( message_float( message( left, sel.yAxis ), sel.value ), -1.0f, 1.0f );
+    pad->right_x = clamp( message_float( message( right, sel.xAxis ), sel.value ), -1.0f, 1.0f );
+    pad->right_y = clamp( message_float( message( right, sel.yAxis ), sel.value ), -1.0f, 1.0f );
+    copy_string( pad->name, sizeof(pad->name), message( controller, sel.vendorName ) );
+    copy_string( pad->category, sizeof(pad->category), message( controller, sel.productCategory ) );
+}
+
+static NTSTATUS apple_pads_poll( void *args )
+{
+    struct apple_pads_params *params = args;
+    unsigned long i, count;
+    id controllers;
+    void *pool;
+
+    params->count = 0;
+    pthread_once( &init_once, load_framework );
+    if (!controller_class) return STATUS_NOT_SUPPORTED;
+
+    pool = p_objc_autoreleasePoolPush();
+    controllers = message( controller_class, sel.controllers );
+    count = answers( controllers, sel.count ) ? ((unsigned long (*)( id, SEL ))p_objc_msgSend)( controllers, sel.count ) : 0;
+    for (i = 0; i < count && params->count < APPLE_PADS_MAX; i++)
+    {
+        id controller = ((id (*)( id, SEL, unsigned long ))p_objc_msgSend)( controllers, sel.objectAtIndex, i );
+        id gamepad = message( controller, sel.extendedGamepad );
+        /* a pad with sticks, triggers and four face buttons; a micro gamepad or a remote is not one */
+        if (!gamepad) continue;
+        read_pad( controller, gamepad, &params->pads[params->count++] );
+    }
+    p_objc_autoreleasePoolPop( pool );
+    return STATUS_SUCCESS;
+}
+
+#else  /* __APPLE__ */
+
+static NTSTATUS apple_pads_poll( void *args )
+{
+    struct apple_pads_params *params = args;
+    params->count = 0;
+    return STATUS_NOT_SUPPORTED;
+}
+
+#endif /* __APPLE__ */
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    apple_pads_poll,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
