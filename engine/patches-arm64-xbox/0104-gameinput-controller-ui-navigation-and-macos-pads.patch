+/* No pad on XInput: the pads macOS itself knows, each kept in its slot for as long as it stays connected. */
+static void update_pads_apple( uint64_t now )
+{
+    struct apple_pads_params params;
+    BOOL used[APPLE_PADS_MAX] = {0};
+    unsigned int i, k;
+
+    static int last_count = -1;
+    NTSTATUS status;
+
+    memset( &params, 0, sizeof(params) );
+    if ((status = WINE_UNIX_CALL( unix_apple_pads_poll, &params )) || params.count > APPLE_PADS_MAX) params.count = 0;
+    if ((int)params.count != last_count)
+    {
+        if (status) WARN( "GameController.framework could not be used (%#lx): no pads from macOS\n", status );
+        else TRACE( "GameController.framework knows %u pad(s)\n", params.count );
+        last_count = params.count;
+    }
+    for (i = 0; i < MAX_PADS; i++)
+    {
+        struct device *pad = &pads[i];
+        if (!pad->connected) continue;
+        for (k = 0; k < params.count; k++) if (!used[k] && params.pads[k].handle == pad->apple_handle) break;
+        if (pad->source != SOURCE_APPLE || k == params.count)
+        {
+            disconnect_pad( pad );
+            continue;
+        }
+        used[k] = TRUE;
+        apple_pad_input( pad, &params.pads[k], now );
+    }
+    for (k = 0; k < params.count; k++)
+    {
+        WORD vid, pid;
+        if (used[k]) continue;
+        for (i = 0; i < MAX_PADS && pads[i].connected; i++) ;
+        if (i == MAX_PADS) break;
+        vid = apple_vendor( &params.pads[k], &pid );
+        params.pads[k].name[sizeof(params.pads[k].name) - 1] = 0;
+        connect_pad( &pads[i], SOURCE_APPLE, vid, pid, 0, params.pads[k].name[0] ? params.pads[k].name : pad_name( vid ) );
+        pads[i].apple_handle = params.pads[k].handle;
+        apple_pad_input( &pads[i], &params.pads[k], now );
+    }
+}
