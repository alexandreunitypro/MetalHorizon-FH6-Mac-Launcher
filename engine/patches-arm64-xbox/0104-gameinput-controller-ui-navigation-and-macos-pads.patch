+/* The pad as a generic controller. Axes go from 0 to 1, as a HID axis does: the sticks rest at 0.5, their Y axes
+ * grow downwards, and the triggers rest at 0. */
+static uint32_t reading_controller_count( struct reading *reading, uint32_t pad_count )
+{
+    return reading->device->type == DEVICE_GAMEPAD ? pad_count : 0;
+}
+
+static uint32_t reading_get_axes( struct reading *reading, uint32_t count, float *state )
+{
+    const GameInputGamepadState *pad = &reading->gamepad;
+    float axes[PAD_AXES];
+    uint32_t n;
+
+    if (reading->device->type != DEVICE_GAMEPAD || !state) return zero_count( count, state, sizeof(*state) );
+    axes[0] = (pad->leftThumbstickX + 1.0f) / 2.0f;
+    axes[1] = (1.0f - pad->leftThumbstickY) / 2.0f;
+    axes[2] = (pad->rightThumbstickX + 1.0f) / 2.0f;
+    axes[3] = (1.0f - pad->rightThumbstickY) / 2.0f;
+    axes[4] = pad->leftTrigger;
+    axes[5] = pad->rightTrigger;
+    n = min( count, PAD_AXES );
+    memcpy( state, axes, n * sizeof(*state) );
+    if (count > n) memset( state + n, 0, (count - n) * sizeof(*state) );
+    return n;
+}
+
+static uint32_t reading_get_buttons( struct reading *reading, uint32_t count, bool *state )
+{
+    uint32_t i, n;
+
+    if (reading->device->type != DEVICE_GAMEPAD || !state) return zero_count( count, state, sizeof(*state) );
+    n = min( count, PAD_BUTTONS );
+    for (i = 0; i < n; i++) state[i] = (reading->gamepad.buttons & button_bits[i]) != 0;
+    for (; i < count; i++) state[i] = false;
+    return n;
 }
 
+static GameInputSwitchPosition dpad_position( GameInputGamepadButtons buttons )
+{
+    BOOL up = buttons & GameInputGamepadDPadUp, down = buttons & GameInputGamepadDPadDown;
+    BOOL left = buttons & GameInputGamepadDPadLeft, right = buttons & GameInputGamepadDPadRight;
+
+    if (up && !down) return right && !left ? GameInputSwitchUpRight : left && !right ? GameInputSwitchUpLeft : GameInputSwitchUp;
+    if (down && !up) return right && !left ? GameInputSwitchDownRight : left && !right ? GameInputSwitchDownLeft : GameInputSwitchDown;
+    if (right && !left) return GameInputSwitchRight;
+    if (left && !right) return GameInputSwitchLeft;
+    return GameInputSwitchCenter;
+}
+
+static uint32_t reading_get_switches( struct reading *reading, uint32_t count, GameInputSwitchPosition *state )
