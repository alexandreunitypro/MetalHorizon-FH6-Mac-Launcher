+/* The vendor and product a macOS pad would have, from its product category ("DualSense", "Xbox One"...). */
+static WORD apple_vendor( const struct apple_pad *state, WORD *pid )
+{
+    if (strstr( state->category, "DualSense" )) { *pid = 0x0ce6; return 0x054c; }
+    if (strstr( state->category, "DualShock" )) { *pid = 0x09cc; return 0x054c; }
+    if (strstr( state->category, "Switch" )) { *pid = 0x2009; return 0x057e; }
+    *pid = 0x02ea;
+    return 0x045e;
+}
+
+static void apple_pad_input( struct device *pad, const struct apple_pad *state, uint64_t now )
+{
+    BOOL changed = pad->packet == ~0u || memcmp( &pad->apple, state, sizeof(*state) );
+
+    pad->apple = *state;
+    if (!changed) return;
+    pad->packet = 0;
+    pad_input( pad, state->buttons, state->left_trigger, state->right_trigger, state->left_x, state->left_y,
+               state->right_x, state->right_y, now );
+}
