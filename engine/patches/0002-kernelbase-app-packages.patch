+/*
+ * A packaged app (UWP / MSIX / GDK) is laid out with an AppxManifest.xml -- or,
+ * for a GDK title, a MicrosoftGame.config -- next to its executable. Windows
+ * stamps such a process with a package identity; unpackaged processes have
+ * none and the GetCurrentPackage* family returns APPMODEL_ERROR_NO_PACKAGE.
+ *
+ * Wine had all of these hard-stubbed to "no package", which is why UWP apps
+ * abort at startup with APPMODEL_ERROR_NO_PACKAGE. Here we synthesise the
+ * identity from the manifest the same way Windows names a package:
+ *
+ *   family name = <Name>_<publisher id>
+ *   full name   = <Name>_<Version>_<Arch>_<ResourceId>_<publisher id>
+ *
+ * where the 13-character publisher id is Crockford base32 of the first eight
+ * bytes of SHA-256 over the UTF-16LE publisher string (e.g. Microsoft's
+ * "CN=Microsoft Corporation, ..." hashes to "8wekyb3d8bbwe").
+ *
+ * The launcher may point us straight at the manifest with WINE_PACKAGE_MANIFEST;
+ * otherwise we look for one beside the current executable.
+ */
+
+#include <stdarg.h>
+#include <stdint.h>
+#include <string.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "winreg.h"
+#include "winerror.h"
+#include "winternl.h"
+#include "appmodel.h"
+
+#include "kernelbase.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(appmodel);
+
+/* Wine's appmodel.h declares PACKAGE_ID but not the flat PACKAGE_INFO record
+ * GetCurrentPackageInfo fills, so define it here with the documented layout. */
+typedef struct _PACKAGE_INFO
+{
+    UINT32     reserved;
+    UINT32     flags;
+    PWSTR      path;
+    PWSTR      packageFullName;
+    PWSTR      packageFamilyName;
+    PACKAGE_ID packageId;
+} PACKAGE_INFO;
+
+/* ------------------------------------------------------------------ */
+/* SHA-256 (public-domain style, self-contained: keeps kernelbase from
+ * depending on bcrypt, and it only ever runs once per process). */
+
+struct sha256
+{
+    uint32_t h[8];
+    uint64_t len;
+    unsigned char buf[64];
+    unsigned int n;
+};
+
+static uint32_t ror32( uint32_t v, unsigned int c ) { return (v >> c) | (v << (32 - c)); }
+
+static void sha256_block( struct sha256 *s, const unsigned char *p )
+{
+    static const uint32_t k[64] =
+    {
+        0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
+        0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
+        0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
+        0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
+        0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
+        0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
+        0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
+        0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2,
+    };
+    uint32_t w[64], a, b, c, d, e, f, g, h, t1, t2;
+    unsigned int i;
+
+    for (i = 0; i < 16; i++)
+        w[i] = (p[i*4] << 24) | (p[i*4+1] << 16) | (p[i*4+2] << 8) | p[i*4+3];
+    for (i = 16; i < 64; i++)
+    {
+        uint32_t s0 = ror32(w[i-15],7) ^ ror32(w[i-15],18) ^ (w[i-15] >> 3);
+        uint32_t s1 = ror32(w[i-2],17) ^ ror32(w[i-2],19) ^ (w[i-2] >> 10);
+        w[i] = w[i-16] + s0 + w[i-7] + s1;
+    }
+    a = s->h[0]; b = s->h[1]; c = s->h[2]; d = s->h[3];
+    e = s->h[4]; f = s->h[5]; g = s->h[6]; h = s->h[7];
+    for (i = 0; i < 64; i++)
+    {
+        uint32_t S1 = ror32(e,6) ^ ror32(e,11) ^ ror32(e,25);
+        uint32_t ch = (e & f) ^ (~e & g);
+        uint32_t S0 = ror32(a,2) ^ ror32(a,13) ^ ror32(a,22);
+        uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
+        t1 = h + S1 + ch + k[i] + w[i];
+        t2 = S0 + maj;
+        h = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+    }
+    s->h[0]+=a; s->h[1]+=b; s->h[2]+=c; s->h[3]+=d;
+    s->h[4]+=e; s->h[5]+=f; s->h[6]+=g; s->h[7]+=h;
+}
+
+static void sha256_init( struct sha256 *s )
+{
+    s->h[0]=0x6a09e667; s->h[1]=0xbb67ae85; s->h[2]=0x3c6ef372; s->h[3]=0xa54ff53a;
+    s->h[4]=0x510e527f; s->h[5]=0x9b05688c; s->h[6]=0x1f83d9ab; s->h[7]=0x5be0cd19;
+    s->len = 0; s->n = 0;
+}
+
+static void sha256_update( struct sha256 *s, const void *data, size_t len )
+{
+    const unsigned char *p = data;
+    s->len += len;
+    while (len)
+    {
+        unsigned int take = 64 - s->n;
+        if (take > len) take = len;
+        memcpy( s->buf + s->n, p, take );
+        s->n += take; p += take; len -= take;
+        if (s->n == 64) { sha256_block( s, s->buf ); s->n = 0; }
+    }
+}
+
+static void sha256_final( struct sha256 *s, unsigned char out[32] )
+{
+    uint64_t bits = s->len * 8;
+    unsigned int i;
+    unsigned char pad = 0x80;
+
+    sha256_update( s, &pad, 1 );
+    pad = 0;
+    while (s->n != 56) sha256_update( s, &pad, 1 );
+    for (i = 0; i < 8; i++) { unsigned char b = (bits >> (56 - i*8)) & 0xff; sha256_update( s, &b, 1 ); }
+    for (i = 0; i < 8; i++)
+    {
+        out[i*4]   = s->h[i] >> 24; out[i*4+1] = s->h[i] >> 16;
+        out[i*4+2] = s->h[i] >> 8;  out[i*4+3] = s->h[i];
+    }
+}
+
+/* 13-char Crockford base32 publisher id from a UTF-16LE publisher string. */
+static void publisher_id_from_string( const WCHAR *publisher, WCHAR out[14] )
+{
+    static const char alphabet[] = "0123456789abcdefghjkmnpqrstvwxyz";
+    struct sha256 ctx;
+    unsigned char hash[32];
+    UINT64 v = 0;
+    int i;
+
+    sha256_init( &ctx );
+    sha256_update( &ctx, publisher, lstrlenW(publisher) * sizeof(WCHAR) );
+    sha256_final( &ctx, hash );
+
+    for (i = 0; i < 8; i++) v = (v << 8) | hash[i];
+    for (i = 0; i < 12; i++) out[i] = alphabet[(v >> (59 - 5 * i)) & 31];
+    out[12] = alphabet[(v & 15) << 1];
+    out[13] = 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Manifest discovery and parsing. */
+
+static char *read_text_file( const WCHAR *path )
+{
+    HANDLE file;
+    DWORD size, got = 0, off = 0;
+    char *buf;
+
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING,
+                        FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+
+    size = GetFileSize( file, NULL );
+    if (size == INVALID_FILE_SIZE || size > 4*1024*1024)
+    {
+        CloseHandle( file );
+        return NULL;
+    }
+    if (!(buf = HeapAlloc( GetProcessHeap(), 0, size + 1 )))
+    {
+        CloseHandle( file );
+        return NULL;
+    }
+    while (off < size && ReadFile( file, buf + off, size - off, &got, NULL ) && got)
+        off += got;
+    CloseHandle( file );
+    buf[off] = 0;
+    return buf;
+}
+
+static BOOL is_xml_space( char c )
+{
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+}
+
+/* Find the start tag of element @elem (a bare name, e.g. "Application") and
+ * return a pointer just past its name. The name has to end there: a plain
+ * substring search for "<Application" finds the <Applications> wrapper first,
+ * and the Id it was after belongs to the element inside it. Comments,
+ * processing instructions and CDATA are skipped, because a '<' in them does
+ * not start an element. */
+static const char *find_element( const char *xml, const char *elem )
+{
+    size_t n = strlen( elem );
+    const char *p = xml;
+
+    while ((p = strchr( p, '<' )))
+    {
+        if (!strncmp( p, "<!--", 4 ))
+        {
+            if (!(p = strstr( p + 4, "-->" ))) return NULL;
+            p += 3;
+        }
+        else if (!strncmp( p, "<![CDATA[", 9 ))
+        {
+            if (!(p = strstr( p + 9, "]]>" ))) return NULL;
+            p += 3;
+        }
+        else if (p[1] == '?')
+        {
+            if (!(p = strstr( p + 2, "?>" ))) return NULL;
+            p += 2;
+        }
+        else if (!strncmp( p + 1, elem, n ) &&
+                 (is_xml_space( p[1 + n] ) || p[1 + n] == '/' || p[1 + n] == '>'))
+            return p + 1 + n;
+        else p++;
+    }
+    return NULL;
+}
+
+/* Append code point @c to @out as UTF-8. FALSE when it does not fit. */
+static BOOL put_utf8( unsigned int c, char *out, size_t cap, size_t *pos )
+{
+    char tmp[4];
+    size_t n, i;
+
+    if (c < 0x80) { tmp[0] = c; n = 1; }
+    else if (c < 0x800) { tmp[0] = 0xc0 | (c >> 6); tmp[1] = 0x80 | (c & 0x3f); n = 2; }
+    else if (c < 0x10000)
+    {
+        tmp[0] = 0xe0 | (c >> 12); tmp[1] = 0x80 | ((c >> 6) & 0x3f); tmp[2] = 0x80 | (c & 0x3f);
+        n = 3;
+    }
+    else
+    {
+        tmp[0] = 0xf0 | (c >> 18); tmp[1] = 0x80 | ((c >> 12) & 0x3f);
+        tmp[2] = 0x80 | ((c >> 6) & 0x3f); tmp[3] = 0x80 | (c & 0x3f);
+        n = 4;
+    }
+    if (*pos + n >= cap) return FALSE;
+    for (i = 0; i < n; i++) out[(*pos)++] = tmp[i];
+    return TRUE;
+}
+
+/* Copy the attribute value @src (@len bytes, between its quotes) into @out as
+ * the string an XML parser would hand over: the five predefined entities and
+ * numeric character references decoded, and literal whitespace turned into
+ * spaces. The publisher id is a hash of the decoded string, so a Publisher
+ * written "CN=A &amp; B" has to be hashed as "CN=A & B" or the family name
+ * comes out wrong. FALSE when the value is malformed or does not fit. */
+static BOOL decode_xml_value( const char *src, size_t len, char *out, size_t cap )
+{
+    static const struct { const char *name; char c; } entities[] =
+    {
+        { "amp;", '&' }, { "lt;", '<' }, { "gt;", '>' }, { "quot;", '"' }, { "apos;", '\'' },
+    };
+    const char *end = src + len;
+    size_t pos = 0, i;
+
+    while (src < end)
+    {
+        unsigned int c;
+
+        if (*src != '&')
+        {
+            if (*src == '\r' && src + 1 < end && src[1] == '\n') src++;
+            c = is_xml_space( *src ) ? ' ' : (unsigned char)*src;
+            src++;
+            if (pos + 1 >= cap) return FALSE;
+            out[pos++] = c;
+            continue;
+        }
+        src++;
+        if (src < end && *src == '#')
+        {
+            BOOL hex = FALSE;
+            unsigned int digits = 0;
+
+            src++;
+            if (src < end && *src == 'x') { hex = TRUE; src++; }
+            c = 0;
+            while (src < end && *src != ';')
+            {
+                unsigned int d;
+
+                if (*src >= '0' && *src <= '9') d = *src - '0';
+                else if (hex && *src >= 'a' && *src <= 'f') d = *src - 'a' + 10;
+                else if (hex && *src >= 'A' && *src <= 'F') d = *src - 'A' + 10;
+                else return FALSE;
+                c = c * (hex ? 16 : 10) + d;
+                if (c > 0x10ffff) return FALSE;
+                digits++;
+                src++;
+            }
+            if (src >= end || !digits || !c || (c >= 0xd800 && c <= 0xdfff)) return FALSE;
+            src++;
+            if (!put_utf8( c, out, cap, &pos )) return FALSE;
+            continue;
+        }
+        for (i = 0; i < ARRAY_SIZE(entities); i++)
+        {
+            size_t n = strlen( entities[i].name );
+            if ((size_t)(end - src) >= n && !memcmp( src, entities[i].name, n ))
+            {
+                if (pos + 1 >= cap) return FALSE;
+                out[pos++] = entities[i].c;
+                src += n;
+                break;
+            }
+        }
+        if (i == ARRAY_SIZE(entities)) return FALSE;
+    }
+    out[pos] = 0;
+    return TRUE;
+}
+
+/* Copy the decoded value of attribute @attr (a bare name, e.g. "Publisher")
+ * of the first @elem element into @out. Attributes are read one by one rather
+ * than searched for, so a name only matches a whole attribute name, whatever
+ * whitespace precedes it and whichever quote it uses. */
+static BOOL manifest_attr( const char *xml, const char *elem, const char *attr,
+                          char *out, size_t cap )
+{
+    size_t attr_len = strlen( attr );
+    const char *p, *name, *name_end, *value;
+    char quote;
+
+    if (!(p = find_element( xml, elem ))) return FALSE;
+    for (;;)
+    {
+        while (is_xml_space( *p )) p++;
+        if (!*p || *p == '>' || *p == '/') return FALSE;
+        name = p;
+        while (*p && *p != '=' && *p != '>' && *p != '/' && !is_xml_space( *p )) p++;
+        name_end = p;
+        while (is_xml_space( *p )) p++;
+        if (*p != '=') return FALSE;
+        p++;
+        while (is_xml_space( *p )) p++;
+        if (*p != '"' && *p != '\'') return FALSE;
+        quote = *p++;
+        value = p;
+        if (!(p = strchr( value, quote ))) return FALSE;
+        if ((size_t)(name_end - name) == attr_len && !memcmp( name, attr, attr_len ))
+            return decode_xml_value( value, p - value, out, cap );
+        p++;
+    }
+}
+
+static WCHAR *utf8_to_wide( const char *s )
+{
+    int n = MultiByteToWideChar( CP_UTF8, 0, s, -1, NULL, 0 );
+    WCHAR *w;
+    if (n <= 0 || !(w = HeapAlloc( GetProcessHeap(), 0, n * sizeof(WCHAR) ))) return NULL;
+    MultiByteToWideChar( CP_UTF8, 0, s, -1, w, n );
+    return w;
+}
+
+/* An environment variable in a buffer of whatever size it needs. A fixed
+ * MAX_PATH buffer is not enough: for a longer value GetEnvironmentVariableW
+ * reports the size it wants and leaves the buffer untouched, and a game under a
+ * deep data directory can have a path past 260 characters. */
+static WCHAR *get_env_alloc( const WCHAR *name )
+{
+    WCHAR *buf = NULL;
+    DWORD size = 0, got;
+
+    for (;;)
+    {
+        got = GetEnvironmentVariableW( name, buf, size );
+        if (!got) break;
+        if (got < size) return buf;
+        HeapFree( GetProcessHeap(), 0, buf );
+        size = got;
+        if (!(buf = HeapAlloc( GetProcessHeap(), 0, size * sizeof(WCHAR) ))) return NULL;
+    }
+    HeapFree( GetProcessHeap(), 0, buf );
+    return NULL;
+}
+
+/* The main executable's path, likewise not limited to MAX_PATH. */
+static WCHAR *get_exe_path_alloc( void )
+{
+    WCHAR *buf = NULL, *grown;
+    DWORD size = MAX_PATH, got;
+
+    while (size <= 32768)
+    {
+        grown = buf ? HeapReAlloc( GetProcessHeap(), 0, buf, size * sizeof(WCHAR) )
+                    : HeapAlloc( GetProcessHeap(), 0, size * sizeof(WCHAR) );
+        if (!grown) break;
+        buf = grown;
+        if (!(got = GetModuleFileNameW( NULL, buf, size ))) break;
+        if (got < size) return buf;
+        size *= 2;
+    }
+    HeapFree( GetProcessHeap(), 0, buf );
+    return NULL;
+}
+
+/* @dir followed by a backslash and @file, newly allocated. */
+static WCHAR *path_join_alloc( const WCHAR *dir, const WCHAR *file )
+{
+    SIZE_T n = lstrlenW( dir ) + 1 + lstrlenW( file ) + 1;
+    WCHAR *r = HeapAlloc( GetProcessHeap(), 0, n * sizeof(WCHAR) );
+
+    if (r) swprintf( r, n, L"%s\\%s", dir, file );
+    return r;
+}
+
+/* Locate the manifest and its directory. Returns TRUE and sets @manifest and
+ * @dir to newly allocated DOS paths when a packaged layout is found. */
+static BOOL find_manifest( WCHAR **manifest, WCHAR **dir )
+{
+    static const WCHAR * const names[] = { L"AppxManifest.xml", L"MicrosoftGame.config" };
+    WCHAR *path, *exe_dir, *slash;
+    unsigned int i;
+
+    *manifest = *dir = NULL;
+
+    if ((path = get_env_alloc( L"WINE_PACKAGE_MANIFEST" )))
+    {
+        if (GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES &&
+            (*dir = HeapAlloc( GetProcessHeap(), 0, (lstrlenW( path ) + 1) * sizeof(WCHAR) )))
+        {
+            lstrcpyW( *dir, path );
+            if ((slash = wcsrchr( *dir, '\\' ))) *slash = 0;
+            *manifest = path;
+            return TRUE;
+        }
+        HeapFree( GetProcessHeap(), 0, path );
+    }
+
+    if (!(exe_dir = get_exe_path_alloc())) return FALSE;
+    if (!(slash = wcsrchr( exe_dir, '\\' )))
+    {
+        HeapFree( GetProcessHeap(), 0, exe_dir );
+        return FALSE;
+    }
+    *slash = 0;
+
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        if (!(path = path_join_alloc( exe_dir, names[i] ))) break;
+        if (GetFileAttributesW( path ) != INVALID_FILE_ATTRIBUTES)
+        {
+            *manifest = path;
+            *dir = exe_dir;
+            return TRUE;
+        }
+        HeapFree( GetProcessHeap(), 0, path );
+    }
+    HeapFree( GetProcessHeap(), 0, exe_dir );
+    return FALSE;
+}
+
+/* ------------------------------------------------------------------ */
+/* Resolved identity, computed once. NULL when this process is unpackaged. */
+
+static WCHAR *pkg_full_name;
+static WCHAR *pkg_family_name;
+static WCHAR *pkg_path;
+static WCHAR *pkg_aumid;
+static INIT_ONCE pkg_once = INIT_ONCE_STATIC_INIT;
+
+static WCHAR *wide_dup( const WCHAR *s )
+{
+    WCHAR *r = HeapAlloc( GetProcessHeap(), 0, (lstrlenW(s) + 1) * sizeof(WCHAR) );
+    if (r) lstrcpyW( r, s );
+    return r;
+}
+
+static BOOL WINAPI resolve_identity( INIT_ONCE *once, void *param, void **ctx )
+{
+    WCHAR *manifest, *dir, buf[512];
+    WCHAR *name_w = NULL, *pub_w = NULL, *arch_w, *ver_w, *app_w;
+    char name[128], publisher[512], version[64], arch[32], app[128];
+    WCHAR pubid[14];
+    char *xml;
+
+    if (!find_manifest( &manifest, &dir ))
+    {
+        TRACE( "no manifest found; process is unpackaged.\n" );
+        return TRUE;
+    }
+    if (!(xml = read_text_file( manifest )))
+        WARN( "manifest %s could not be read.\n", debugstr_w(manifest) );
+    else if (!manifest_attr( xml, "Identity", "Name", name, sizeof(name) ) ||
+             !manifest_attr( xml, "Identity", "Publisher", publisher, sizeof(publisher) ))
+    {
+        WARN( "manifest %s lacks an <Identity Name/Publisher>.\n", debugstr_w(manifest) );
+        HeapFree( GetProcessHeap(), 0, xml );
+        xml = NULL;
+    }
+    HeapFree( GetProcessHeap(), 0, manifest );
+    if (!xml)
+    {
+        HeapFree( GetProcessHeap(), 0, dir );
+        return TRUE;
+    }
+    if (!manifest_attr( xml, "Identity", "Version", version, sizeof(version) ))
+        strcpy( version, "1.0.0.0" );
+    if (!manifest_attr( xml, "Identity", "ProcessorArchitecture", arch, sizeof(arch) ))
+        strcpy( arch, "x64" );
+    if (!manifest_attr( xml, "Application", "Id", app, sizeof(app) ))
+        strcpy( app, "App" );
+
+    name_w = utf8_to_wide( name );
+    pub_w  = utf8_to_wide( publisher );
+    arch_w = utf8_to_wide( arch );
+    ver_w  = utf8_to_wide( version );
+    app_w  = utf8_to_wide( app );
+    HeapFree( GetProcessHeap(), 0, xml );
+
+    if (name_w && pub_w && arch_w && ver_w && app_w)
+    {
+        publisher_id_from_string( pub_w, pubid );
+
+        swprintf( buf, ARRAY_SIZE(buf), L"%s_%s", name_w, pubid );
+        pkg_family_name = wide_dup( buf );
+
+        /* full name: Name_Version_Arch_ResourceId(empty)_PublisherId */
+        swprintf( buf, ARRAY_SIZE(buf), L"%s_%s_%s__%s", name_w, ver_w, arch_w, pubid );
+        pkg_full_name = wide_dup( buf );
+
+        pkg_path = dir;
+        dir = NULL;
+
+        swprintf( buf, ARRAY_SIZE(buf), L"%s!%s", pkg_family_name, app_w );
+        pkg_aumid = wide_dup( buf );
+
+        TRACE( "package family %s, full %s, path %s.\n",
+               debugstr_w(pkg_family_name), debugstr_w(pkg_full_name), debugstr_w(pkg_path) );
+    }
+
+    HeapFree( GetProcessHeap(), 0, name_w );
+    HeapFree( GetProcessHeap(), 0, pub_w );
+    HeapFree( GetProcessHeap(), 0, arch_w );
+    HeapFree( GetProcessHeap(), 0, ver_w );
+    HeapFree( GetProcessHeap(), 0, app_w );
+    HeapFree( GetProcessHeap(), 0, dir );
+    return TRUE;
+}
+
+static void ensure_identity( void )
+{
+    InitOnceExecuteOnce( &pkg_once, resolve_identity, NULL, NULL );
+}
+
+/* Standard two-call length contract shared by the string getters. */
+static LONG return_identity_string( const WCHAR *value, LONG none_error,
+                                    UINT32 *length, WCHAR *buffer )
+{
+    UINT32 needed;
+
+    if (!length) return ERROR_INVALID_PARAMETER;
+    ensure_identity();
+    if (!value)
+    {
+        *length = 0;
+        return none_error;
+    }
+    needed = lstrlenW( value ) + 1;
+    if (*length < needed || !buffer)
+    {
+        *length = needed;
+        return ERROR_INSUFFICIENT_BUFFER;
+    }
+    memcpy( buffer, value, needed * sizeof(WCHAR) );
+    *length = needed;
+    return ERROR_SUCCESS;
+}
+
+static BOOL is_current_process( HANDLE process )
+{
+    return !process || process == GetCurrentProcess();
+}
