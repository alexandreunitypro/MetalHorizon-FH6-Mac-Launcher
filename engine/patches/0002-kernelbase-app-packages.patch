+
+/***********************************************************************
+ *         GetCurrentPackageInfo   (kernelbase.@)
+ *
+ * A single package with no dependencies: one PACKAGE_INFO followed by the
+ * strings its members (including the embedded PACKAGE_ID) point at.
+ */
+LONG WINAPI GetCurrentPackageInfo( const UINT32 flags, UINT32 *buffer_size, BYTE *buffer, UINT32 *count )
+{
+    UINT32 id_size = 0, need, path_b, full_b, fam_b, have;
+    PACKAGE_INFO *info;
+    LONG ret;
+    BYTE *p;
+
+    TRACE( "(%#x %p %p %p)\n", flags, buffer_size, buffer, count );
+
+    if (!buffer_size) return ERROR_INVALID_PARAMETER;
+    ensure_identity();
+    if (!pkg_full_name) return APPMODEL_ERROR_NO_PACKAGE;
+
+    /* Size of the PACKAGE_ID blob (struct + its trailing strings). */
+    ret = PackageIdFromFullName( pkg_full_name, 0, &id_size, NULL );
+    if (ret != ERROR_INSUFFICIENT_BUFFER && ret != ERROR_SUCCESS) return ret;
+
+    path_b = (lstrlenW(pkg_path) + 1) * sizeof(WCHAR);
+    full_b = (lstrlenW(pkg_full_name) + 1) * sizeof(WCHAR);
+    fam_b  = (lstrlenW(pkg_family_name) + 1) * sizeof(WCHAR);
+
+    /* PACKAGE_INFO already contains a PACKAGE_ID by value; we only need extra
+     * room for the id's trailing strings plus the three PWSTR members. */
+    need = sizeof(PACKAGE_INFO) + (id_size - sizeof(PACKAGE_ID)) + path_b + full_b + fam_b;
+
+    have = *buffer_size;
+    *buffer_size = need;
+    if (count) *count = 1;
+    if (!buffer || have < need) return ERROR_INSUFFICIENT_BUFFER;
+
+    memset( buffer, 0, need );
+    info = (PACKAGE_INFO *)buffer;
+
+    /* Write the PACKAGE_ID (and its strings) starting at the embedded id; its
+     * trailing strings land immediately after PACKAGE_INFO. */
+    id_size = need - (UINT32)((BYTE *)&info->packageId - buffer);
+    ret = PackageIdFromFullName( pkg_full_name, 0, &id_size, (BYTE *)&info->packageId );
+    if (ret != ERROR_SUCCESS) return ret;
+
+    p = buffer + sizeof(PACKAGE_INFO) + (id_size - sizeof(PACKAGE_ID));
+    info->path = (WCHAR *)p;
+    memcpy( p, pkg_path, path_b );
+    p += path_b;
+    info->packageFullName = (WCHAR *)p;
+    memcpy( p, pkg_full_name, full_b );
+    p += full_b;
+    info->packageFamilyName = (WCHAR *)p;
+    memcpy( p, pkg_family_name, fam_b );
+
+    return ERROR_SUCCESS;
+}
