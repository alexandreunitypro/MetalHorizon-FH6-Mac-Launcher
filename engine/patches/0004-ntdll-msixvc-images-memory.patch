+/***********************************************************************
+ *           open_mapped_image_file
+ *
+ * Like open_mapped_dll_file(), but hands back a plain file handle for the
+ * decrypted image, so that a title which opens its own payload through the
+ * ordinary file API reads the decrypted image instead of the encrypted
+ * bytes on disk.
+ */
+NTSTATUS open_mapped_image_file( const UNICODE_STRING *nt_name, HANDLE *handle )
+{
+    static const WCHAR globalrootW[] = {'\\','?','?','\\','G','l','o','b','a','l','R','o','o','t'};
+    const char *value = getenv( "WINE_DLL_FILE_MAP" );
+    const char *entry, *sep, *end;
+    const WCHAR *name;
+    unsigned int name_len;
+    char *utf8_name;
+    unsigned int allocLen;
+    NTSTATUS status;
+
+    *handle = 0;
+    ERR( "FHTRACE open_mapped_image_file name=%s env=%s\n",
+         debugstr_us(nt_name), value ? value : "(null)" );
+    if (!value || !*value) return STATUS_DLL_NOT_FOUND;
+    if (!nt_name || !nt_name->Buffer || !nt_name->Length) return STATUS_DLL_NOT_FOUND;
+
+    name = nt_name->Buffer;
+    name_len = nt_name->Length / sizeof(WCHAR);
+
+    if (name_len >= ARRAY_SIZE(globalrootW) && !wcsnicmp( name, globalrootW, ARRAY_SIZE(globalrootW) ))
+    {
+        name += ARRAY_SIZE(globalrootW);
+        name_len -= ARRAY_SIZE(globalrootW);
+    }
+    if (!name_len) return STATUS_DLL_NOT_FOUND;
+
+    if ((status = utf8_wcstombs_size( name, name_len, &allocLen ))) return status;
+    utf8_name = alloca( allocLen );
+    if ((status = utf8_wcstombs( utf8_name, allocLen, &allocLen, name, name_len ))) return status;
+
+    for (entry = value; *entry; entry = *end ? end + 1 : end)
+    {
+        int fd = 0;
+        size_t len;
+        const char *p;
+
+        end = strchr( entry, '|' );
+        if (!end) end = entry + strlen( entry );
+        if (end == entry) continue;
+        sep = strchr( entry, ':' );
+        if (!sep || sep >= end) continue;
+        for (p = entry; p < sep; p++)
+        {
+            if (*p < '0' || *p > '9') { fd = -1; break; }
+            fd = fd * 10 + (*p - '0');
+        }
+        if (fd < 0 || sep == entry || sep + 1 == end) continue;
+        len = end - sep - 1;
+        if (len != allocLen || strncmp( sep + 1, utf8_name, len )) continue;
+        status = mapped_fd_to_handle( fd, handle );
+        ERR( "FHTRACE mapped image match fd=%d name=%s status=%08x\n", fd, utf8_name, status );
+        return status;
+    }
+    ERR( "FHTRACE no mapped image match for %s\n", utf8_name );
+    return STATUS_DLL_NOT_FOUND;
+}
