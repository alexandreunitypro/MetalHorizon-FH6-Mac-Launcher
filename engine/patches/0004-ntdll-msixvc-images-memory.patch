+/* Xodus maps licensed MSIXVC executables from live file descriptors instead
+ * of writing decrypted executables to disk. */
+static NTSTATUS open_mapped_dll_file( const UNICODE_STRING *nt_name, HANDLE *mapping )
+{
+    const char *value = getenv( "WINE_DLL_FILE_MAP" );
+    const char *entry, *sep, *end;
+    char *utf8_name;
+    unsigned int allocLen;
+    NTSTATUS status;
+
+    ERR( "FHTRACE open_mapped_dll_file name=%s env=%s\n",
+         debugstr_us(nt_name), value ? value : "(null)" );
+    if (!value || !*value) return STATUS_DLL_NOT_FOUND;
+    if ((status = utf8_wcstombs_size( nt_name->Buffer, nt_name->Length / sizeof(WCHAR), &allocLen )))
+        return status;
+    utf8_name = alloca( allocLen );
+    if ((status = utf8_wcstombs( utf8_name, allocLen, &allocLen,
+                                 nt_name->Buffer, nt_name->Length / sizeof(WCHAR) )))
+        return status;
+
+    for (entry = value; *entry; entry = *end ? end + 1 : end)
+    {
+        HANDLE handle;
+        LARGE_INTEGER size;
+        size_t len;
+        int fd = 0;
+        const char *p;
+
+        end = strchr( entry, '|' );
+        if (!end) end = entry + strlen( entry );
+        if (end == entry) continue;
+        sep = strchr( entry, ':' );
+        if (!sep || sep >= end) continue;
+        for (p = entry; p < sep; p++)
+        {
+            if (*p < '0' || *p > '9') { fd = -1; break; }
+            fd = fd * 10 + (*p - '0');
+        }
+        if (fd < 0 || sep == entry || sep + 1 == end) continue;
+        len = end - sep - 1;
+        if (len != allocLen || strncmp( sep + 1, utf8_name, len )) continue;
+        ERR( "FHTRACE mapped dll match fd=%d name=%s fcntl=%d errno=%d\n",
+             fd, utf8_name, fcntl( fd, F_GETFD ), errno );
+        if ((status = wine_server_fd_to_handle( fd, GENERIC_READ | SYNCHRONIZE, 0, &handle )))
+        {
+            ERR( "FHTRACE fd_to_handle fd=%d status=%08x\n", fd, status );
+            return status;
+        }
+        size.QuadPart = 0;
+        status = NtCreateSection( mapping, STANDARD_RIGHTS_REQUIRED | SECTION_QUERY |
+                                  SECTION_MAP_READ | SECTION_MAP_EXECUTE,
+                                  NULL, &size, PAGE_EXECUTE_READ, SEC_IMAGE, handle );
+        NtClose( handle );
+        return status;
+    }
+    return STATUS_DLL_NOT_FOUND;
 }
 
 
 /***********************************************************************
+ *           mapped_fd_to_handle
+ */
+/* macOS has no /proc: reopen through the name F_GETPATH gives, which needs the file to keep a
+ * name (see patches/xodus-cli/0001). The reopened file must be the same device and inode. If
+ * nothing works, fall back to the shared descriptor and say so once: a title that hashes its own
+ * image several times then reads nothing on the second pass. */
+static int reopen_mapped_fd( int fd )
+{
+    struct stat st_fd, st_own;
+    int own_fd = -1;
+#ifdef F_GETPATH
+    char path[PATH_MAX];
+
+    if (fcntl( fd, F_GETPATH, path ) != -1) own_fd = open( path, O_RDONLY | O_CLOEXEC );
+#else
+    char path[32];
+
+    snprintf( path, sizeof(path), "/proc/self/fd/%d", fd );
+    own_fd = open( path, O_RDONLY | O_CLOEXEC );
+#endif
+    if (own_fd == -1) return -1;
+    if (fstat( fd, &st_fd ) == -1 || fstat( own_fd, &st_own ) == -1 ||
+        st_fd.st_dev != st_own.st_dev || st_fd.st_ino != st_own.st_ino)
+    {
+        close( own_fd );
+        return -1;
+    }
+    return own_fd;
+}
+
+static NTSTATUS mapped_fd_to_handle( int fd, HANDLE *handle )
+{
+    static int warned;
+    NTSTATUS status;
+    int own_fd;
+
+    if ((own_fd = reopen_mapped_fd( fd )) == -1)
+    {
+        if (!warned++)
+            ERR( "mapped image fd %d cannot be reopened (errno %d); every handle on it shares one "
+                 "file position\n", fd, errno );
+        return wine_server_fd_to_handle( fd, GENERIC_READ | SYNCHRONIZE, 0, handle );
+    }
+
+    status = wine_server_fd_to_handle( own_fd, GENERIC_READ | SYNCHRONIZE, 0, handle );
+    close( own_fd );
+    return status;
+}
