+#define SPATIAL_MAX_FRAMES 4096
+
+static AudioChannelLabel speaker_to_label(DWORD speaker, DWORD mask)
+{
+    BOOL side = (mask & (SPEAKER_SIDE_LEFT | SPEAKER_SIDE_RIGHT)) != 0;
+    switch(speaker){
+    case SPEAKER_FRONT_LEFT: return kAudioChannelLabel_Left;
+    case SPEAKER_FRONT_RIGHT: return kAudioChannelLabel_Right;
+    case SPEAKER_FRONT_CENTER: return kAudioChannelLabel_Center;
+    case SPEAKER_LOW_FREQUENCY: return kAudioChannelLabel_LFEScreen;
+    case SPEAKER_BACK_LEFT: return side ? kAudioChannelLabel_RearSurroundLeft : kAudioChannelLabel_LeftSurround;
+    case SPEAKER_BACK_RIGHT: return side ? kAudioChannelLabel_RearSurroundRight : kAudioChannelLabel_RightSurround;
+    case SPEAKER_FRONT_LEFT_OF_CENTER: return kAudioChannelLabel_LeftCenter;
+    case SPEAKER_FRONT_RIGHT_OF_CENTER: return kAudioChannelLabel_RightCenter;
+    case SPEAKER_BACK_CENTER: return kAudioChannelLabel_CenterSurround;
+    case SPEAKER_SIDE_LEFT: return kAudioChannelLabel_LeftSurround;
+    case SPEAKER_SIDE_RIGHT: return kAudioChannelLabel_RightSurround;
+    case SPEAKER_TOP_CENTER: return kAudioChannelLabel_TopCenterSurround;
+    case SPEAKER_TOP_FRONT_LEFT: return kAudioChannelLabel_LeftTopFront;
+    case SPEAKER_TOP_FRONT_CENTER: return kAudioChannelLabel_CenterTopFront;
+    case SPEAKER_TOP_FRONT_RIGHT: return kAudioChannelLabel_RightTopFront;
+    case SPEAKER_TOP_BACK_LEFT: return kAudioChannelLabel_LeftTopRear;
+    case SPEAKER_TOP_BACK_CENTER: return kAudioChannelLabel_CenterTopRear;
+    case SPEAKER_TOP_BACK_RIGHT: return kAudioChannelLabel_RightTopRear;
+    }
+    return kAudioChannelLabel_Unused;
+}
+
+static UInt32 device_output_channels(AudioDeviceID dev)
+{
+    AudioObjectPropertyAddress addr = { kAudioDevicePropertyStreamConfiguration, kAudioObjectPropertyScopeOutput,
+                                        kAudioObjectPropertyElementMain };
+    AudioBufferList *buffers;
+    UInt32 size = 0, i, channels = 0;
+
+    if(AudioObjectGetPropertyDataSize(dev, &addr, 0, NULL, &size) != noErr || !(buffers = malloc(size)))
+        return 0;
+    if(AudioObjectGetPropertyData(dev, &addr, 0, NULL, &size, buffers) == noErr)
+        for(i = 0; i < buffers->mNumberBuffers; i++)
+            channels += buffers->mBuffers[i].mNumberChannels;
+    free(buffers);
+    return channels;
+}
+
+/* Speakers in the Mac itself, headphones (built-in jack, Bluetooth, USB headsets), or anything
+ * else as external speakers. HB_SPATIAL=speakers|headphones|external overrides the guess. */
+static UInt32 spatial_output_type(AudioDeviceID dev)
+{
+    AudioObjectPropertyAddress addr = { kAudioDevicePropertyTransportType, kAudioObjectPropertyScopeGlobal,
+                                        kAudioObjectPropertyElementMain };
+    const char *env = getenv("HB_SPATIAL");
+    UInt32 transport = 0, source = 0, size = sizeof(transport);
+
+    if(env && !strcmp(env, "speakers")) return kSpatialMixerOutputType_BuiltInSpeakers;
+    if(env && !strcmp(env, "headphones")) return kSpatialMixerOutputType_Headphones;
+    if(env && !strcmp(env, "external")) return kSpatialMixerOutputType_ExternalSpeakers;
+
+    AudioObjectGetPropertyData(dev, &addr, 0, NULL, &size, &transport);
+    switch(transport){
+    case kAudioDeviceTransportTypeBuiltIn:
+        addr.mSelector = kAudioDevicePropertyDataSource;
+        addr.mScope = kAudioObjectPropertyScopeOutput;
+        size = sizeof(source);
+        if(AudioObjectGetPropertyData(dev, &addr, 0, NULL, &size, &source) == noErr && source == 'hdpn')
+            return kSpatialMixerOutputType_Headphones;
+        return kSpatialMixerOutputType_BuiltInSpeakers;
+    case kAudioDeviceTransportTypeBluetooth:
+    case kAudioDeviceTransportTypeBluetoothLE:
+    case kAudioDeviceTransportTypeUSB:
+        return kSpatialMixerOutputType_Headphones;
+    default:
+        return kSpatialMixerOutputType_ExternalSpeakers;
+    }
+}
+
+static OSStatus spatial_source_cb(void *user, AudioUnitRenderActionFlags *flags,
+        const AudioTimeStamp *ts, UInt32 bus, UInt32 nframes, AudioBufferList *data)
+{
+    struct coreaudio_stream *stream = user;
+    UInt32 nch = stream->fmt->nChannels, i, c;
+    AudioBufferList interleaved;
+    float *src = stream->spatial_buf;
+
+    if(nframes > stream->spatial_frames) nframes = stream->spatial_frames;
+    interleaved.mNumberBuffers = 1;
+    interleaved.mBuffers[0].mNumberChannels = nch;
+    interleaved.mBuffers[0].mDataByteSize = nframes * stream->fmt->nBlockAlign;
+    interleaved.mBuffers[0].mData = src;
+    ca_render_cb(stream, flags, ts, 0, nframes, &interleaved);
+
+    for(c = 0; c < nch && c < data->mNumberBuffers; c++){
+        float *dst = data->mBuffers[c].mData;
+        for(i = 0; i < nframes; i++) dst[i] = src[i * nch + c];
+    }
+    if(stream->spatial_lfe >= 0 && data->mNumberBuffers >= 2){
+        float *l = data->mBuffers[0].mData, *r = data->mBuffers[1].mData, *lfe = data->mBuffers[stream->spatial_lfe].mData;
+        for(i = 0; i < nframes; i++){ l[i] += 0.5f * lfe[i]; r[i] += 0.5f * lfe[i]; lfe[i] = 0.0f; }
+    }
+    return noErr;
+}
+
+static OSStatus spatial_pull_cb(void *user, AudioUnitRenderActionFlags *flags,
+        const AudioTimeStamp *ts, UInt32 bus, UInt32 nframes, AudioBufferList *data)
+{
+    struct coreaudio_stream *stream = user;
+    return AudioUnitRender(stream->spatial, flags, ts, 0, nframes, data);
+}
+
+/* Puts AUSpatialMixer between the stream and the device when the stream is a float bed with more
+ * channels than the device. Returns FALSE (and leaves the unit as it was) when it does not apply. */
+static BOOL spatial_setup(struct coreaudio_stream *stream)
+{
+    const WAVEFORMATEXTENSIBLE *fmtex = (const WAVEFORMATEXTENSIBLE *)stream->fmt;
+    AudioComponentDescription desc = { kAudioUnitType_Mixer, kAudioUnitSubType_SpatialMixer, kAudioUnitManufacturer_Apple };
+    AudioStreamBasicDescription in, out;
+    AudioChannelLayout *layout;
+    AURenderCallbackStruct cb;
+    UInt32 nch = stream->fmt->nChannels, one = 1, algo, mode, type, frames = SPATIAL_MAX_FRAMES, i, bit, dev_ch;
+    DWORD mask;
+    size_t layout_size;
+    AudioComponent comp;
+    const char *env = getenv("HB_SPATIAL");
+    OSStatus sc;
+
+    if(env && !strcmp(env, "0")) return FALSE;
+    if(stream->fmt->wFormatTag != WAVE_FORMAT_EXTENSIBLE || !IsEqualGUID(&fmtex->SubFormat, &KSDATAFORMAT_SUBTYPE_IEEE_FLOAT) ||
+       stream->fmt->wBitsPerSample != 32 || nch < 3)
+        return FALSE;
+    mask = fmtex->dwChannelMask;
+    if((UInt32)__builtin_popcount(mask) != nch || !(mask & ~(SPEAKER_FRONT_LEFT | SPEAKER_FRONT_RIGHT | SPEAKER_FRONT_CENTER | SPEAKER_LOW_FREQUENCY)))
+        return FALSE;
+    dev_ch = device_output_channels(stream->dev_id);
+    if(!dev_ch || dev_ch >= nch) return FALSE;
+    if(!(comp = AudioComponentFindNext(NULL, &desc)) || AudioComponentInstanceNew(comp, &stream->spatial) != noErr){
+        stream->spatial = NULL;
+        return FALSE;
+    }
+
+    memset(&in, 0, sizeof(in));
+    in.mSampleRate = stream->fmt->nSamplesPerSec;
+    in.mFormatID = kAudioFormatLinearPCM;
+    in.mFormatFlags = kAudioFormatFlagIsFloat | kAudioFormatFlagIsPacked | kAudioFormatFlagIsNonInterleaved;
+    in.mBytesPerPacket = in.mBytesPerFrame = 4;
+    in.mFramesPerPacket = 1;
+    in.mChannelsPerFrame = nch;
+    in.mBitsPerChannel = 32;
+    out = in;
+    out.mChannelsPerFrame = 2;
+
+    layout_size = offsetof(AudioChannelLayout, mChannelDescriptions) + nch * sizeof(AudioChannelDescription);
+    layout = calloc(1, layout_size);
+    layout->mChannelLayoutTag = kAudioChannelLayoutTag_UseChannelDescriptions;
+    layout->mNumberChannelDescriptions = nch;
+    stream->spatial_lfe = -1;
+    for(i = 0, bit = 1; bit && i < nch; bit <<= 1){
+        if(!(mask & bit)) continue;
+        if(bit == SPEAKER_LOW_FREQUENCY) stream->spatial_lfe = i;
+        layout->mChannelDescriptions[i++].mChannelLabel = speaker_to_label(bit, mask);
+    }
+
+    type = spatial_output_type(stream->dev_id);
+    algo = kSpatializationAlgorithm_UseOutputType;
+    mode = kSpatialMixerSourceMode_AmbienceBed;
+    if(type != kSpatialMixerOutputType_BuiltInSpeakers) stream->spatial_lfe = -1;
+
+    if((sc = AudioUnitSetProperty(stream->spatial, kAudioUnitProperty_ElementCount, kAudioUnitScope_Input, 0, &one, sizeof(one))) ||
+       (sc = AudioUnitSetProperty(stream->spatial, kAudioUnitProperty_MaximumFramesPerSlice, kAudioUnitScope_Global, 0, &frames, sizeof(frames))) ||
+       (sc = AudioUnitSetProperty(stream->spatial, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Input, 0, &in, sizeof(in))) ||
+       (sc = AudioUnitSetProperty(stream->spatial, kAudioUnitProperty_AudioChannelLayout, kAudioUnitScope_Input, 0, layout, layout_size)) ||
+       (sc = AudioUnitSetProperty(stream->spatial, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Output, 0, &out, sizeof(out))) ||
+       (sc = AudioUnitSetProperty(stream->spatial, kAudioUnitProperty_SpatializationAlgorithm, kAudioUnitScope_Input, 0, &algo, sizeof(algo))) ||
+       (sc = AudioUnitSetProperty(stream->spatial, kAudioUnitProperty_SpatialMixerSourceMode, kAudioUnitScope_Input, 0, &mode, sizeof(mode))) ||
+       (sc = AudioUnitSetProperty(stream->spatial, kAudioUnitProperty_SpatialMixerOutputType, kAudioUnitScope_Global, 0, &type, sizeof(type)))){
+        WARN("spatial mixer setup failed: %d\n", (int)sc);
+        goto fail;
+    }
+    free(layout);
+    layout = NULL;
+
+    cb.inputProc = spatial_source_cb;
+    cb.inputProcRefCon = stream;
+    if((sc = AudioUnitSetProperty(stream->spatial, kAudioUnitProperty_SetRenderCallback, kAudioUnitScope_Input, 0, &cb, sizeof(cb))) ||
+       (sc = AudioUnitInitialize(stream->spatial))){
+        WARN("spatial mixer start failed: %d\n", (int)sc);
+        goto fail;
+    }
+
+    if((sc = AudioUnitSetProperty(stream->unit, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Input, 0, &out, sizeof(out)))){
+        WARN("couldn't give the device a stereo stream: %d\n", (int)sc);
+        goto fail;
+    }
+
+    stream->spatial_frames = SPATIAL_MAX_FRAMES;
+    stream->spatial_buf = malloc(SPATIAL_MAX_FRAMES * stream->fmt->nBlockAlign);
+    if(!stream->spatial_buf) goto fail;
+
+    MESSAGE("winecoreaudio: %u-channel stream (mask %#x) rendered by AUSpatialMixer for %s on a %u-channel device\n",
+            (unsigned)nch, (unsigned)mask,
+            type == kSpatialMixerOutputType_BuiltInSpeakers ? "built-in speakers" :
+            type == kSpatialMixerOutputType_Headphones ? "headphones" : "external speakers", (unsigned)dev_ch);
+    return TRUE;
+
+fail:
+    free(layout);
+    AudioComponentInstanceDispose(stream->spatial);
+    stream->spatial = NULL;
+    /* put the device unit back on the stream's own format */
+    AudioUnitSetProperty(stream->unit, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Input, 0, &stream->dev_desc, sizeof(stream->dev_desc));
+    return FALSE;
 }
 
