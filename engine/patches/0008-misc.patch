+        this->item = NULL;
+        return;
+    }
+    slot = data->position / QUEUES_NO & (data->queue->alloc_count - 1);
+    page = data->pages[data->position % QUEUES_NO];
+    this->item = page->data + slot * data->queue->item_size;
 }
 
