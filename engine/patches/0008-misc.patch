+
+static void queue_iterator_refresh(_Concurrent_queue_iterator_base_v4 *this)
+{
+    queue_iterator_data *data = this->data;
+    size_t slot;
+    _Page *page;
+    if (data->position == data->queue->data->tail_pos)
