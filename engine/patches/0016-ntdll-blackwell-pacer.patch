     init_startup_info();
     *(ULONG_PTR *)&peb->CloudFileFlags = get_image_address();
     set_load_order_app_name( main_wargv[0] );
+    /* Blackwell Pacer and Trap Boost (bw_pacer.h, bw_trapboost.h): Rosetta's translator stops kept short and its
+     * exception server raised, in the one program BW_PACER_EXE names and only when the variables ask for them */
+    {
+        const WCHAR *name = main_wargv[0], *p;
+        char exe[64];
