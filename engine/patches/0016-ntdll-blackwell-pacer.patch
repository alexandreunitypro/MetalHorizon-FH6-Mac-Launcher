+        while (name[i] && i < sizeof(exe) - 1) { exe[i] = name[i] < 128 ? (char)name[i] : '?'; i++; }
+        exe[i] = 0;
+        bw_pacer_start( exe );
+        bw_trapboost_start( exe );
+    }
     init_thread_stack( teb, 0, 0, 0 );
     NtCreateKeyedEvent( &keyed_event, GENERIC_READ | GENERIC_WRITE, NULL, 0 );
     load_ntdll();
