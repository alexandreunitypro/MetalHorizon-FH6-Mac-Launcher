ntdll: Blackwell Pacer and Trap Boost, for Rosetta, in the program BW_PACER_EXE names (beta engine)

Forza Horizon 6's protection rewrites its code all the time; under Rosetta every rewritten piece is translated again,
the translator's store fills, and Rosetta empties it in one go while every thread that needs it waits: a freeze of
100-300 ms every 10-18 s (engine/tests/rosetta-pacer). Found by Mathias Kowoll (MacGameFix) after Gauthier
Piarrette (Highball) first reported the protection under Rosetta; MacGameFix's countermeasure is a thread running
large functions never seen before at a fixed duty. This is Blackwell Engine's own: in ntdll's Unix side, started at
process start only for BW_PACER_EXE (forzahorizon6.exe) and only when Rosetta translates the process, with
BW_PACER=auto tuning its duty from the stops it sees itself. On the bench (M5 Pro, 120 s): no stop of 20 ms or more
(off: about 240 ms every 18 s), for 10-14 % of the load's throughput, against 26-30 % at MacGameFix's fixed 40.

Since beta 1.3a2, bw_trapboost.h too: Rosetta's exception server (com.apple.rosetta.exceptionserver, the one thread
that services every trap of a translated process) raised to the tiers and precedence of a highest-priority thread
when BW_TRAP_BOOST=1, as MacGameFix's trap boost plugin does for NotProton. On the bench, trapping threads at a low
priority against busy high-priority threads: 108 us a trap without it, 60 us with it (M5 Pro). The pacer's auto duty
now stops at 60 % (MacGameFix: from about 65 % the game's own short pause grows).

diff -ruN a/dlls/ntdll/unix/bw_pacer.h b/dlls/ntdll/unix/bw_pacer.h
--- a/dlls/ntdll/unix/bw_pacer.h	1970-01-01 01:00:00
+++ b/dlls/ntdll/unix/bw_pacer.h	2026-11-21 12:30:42
@@ -0,0 +1,223 @@
+/*
+ * Blackwell Pacer: keeps Rosetta's translator stops short in a program that rewrites its own code all the time.
+ *
+ * The problem (found by Mathias Kowoll for MacGameFix, after Gauthier Piarrette first reported Forza Horizon 6's
+ * protection under Rosetta): the protection keeps rewriting code, Rosetta translates every rewritten piece again,
+ * its store of translations fills, and Rosetta empties it in one go. While it does, every thread that needs the
+ * translator waits, about 0.4 us per translation the store holds: Forza Horizon 6 freezes 100-170 ms every ~10 s
+ * (and engine/tests/rosetta-pacer measures 297-302 ms every 12.9 s on an M5 Pro, with no game and no Wine).
+ * MacGameFix's countermeasure is a thread that runs large functions never seen before, at a duty the player picks:
+ * they fill the store with few translations, Rosetta empties it more often, and each stop is short.
+ *
+ * What this one does differently (Blackwell Engine's own code, written for it):
+ *   - It lives in Wine's ntdll (the Unix side, which under Rosetta is translated x86 code like the game), not in a
+ *     DLL the game loads, and starts only in the program it is meant for (BW_PACER_EXE, forzahorizon6.exe by
+ *     default), only when the process really runs under Rosetta.
+ *   - BW_PACER=auto (what MetalHorizon's beta engine sets) tunes its own duty: it sees the translator's stops
+ *     itself (one of its calls that waits far longer than a call takes), raises its duty while stops last long,
+ *     and lowers it while they stay short, so it takes as little translator time from the game as the machine
+ *     needs. MacGameFix found the right duty differs from one chip to the next; this one looks for it.
+ *   - BW_PACER=<duty>[,<bytes>] keeps a fixed duty (1-100 per cent of each 10 ms) and function size; BW_PACER=off,
+ *     0 or no variable: no thread.
+ *   - Every 10 s one line on stderr (the game's log): duty, functions made, the stops it saw and the longest.
+ *
+ * Plain POSIX: the same file builds into ntdll.so and into the macOS bench (engine/tests/rosetta-pacer).
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef BW_PACER_H
+#define BW_PACER_H
+
+#include <pthread.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/mman.h>
+#include <sys/sysctl.h>
+#include <time.h>
+#include <unistd.h>
+
+#define BW_PACER_REGION   ((size_t)64 << 20)   /* the functions go through this region, then start over */
+#define BW_PACER_SLICE_NS 10000000ull          /* a duty is a share of each 10 ms */
+#define BW_PACER_WINDOW   3000000000ull        /* auto: one decision every 3 s */
+#define BW_PACER_STOP_NS  15000000ull          /* a call that took 15 ms or more waited for the translator */
+
+struct bw_pacer
+{
+    unsigned duty;          /* per cent of each slice spent making and running functions */
+    unsigned bytes;         /* size of each function */
+    int      automatic;     /* duty tuned from the stops seen */
+    unsigned min_duty, max_duty;
+    /* what was seen */
+    unsigned long long made, stops;
+    unsigned long long longest_ns, window_longest_ns;
+    unsigned quiet_windows;
+};
+
+static inline uint64_t bw_pacer_now(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (uint64_t)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+static inline void bw_pacer_sleep_ns( uint64_t ns )
+{
+    struct timespec ts = { (time_t)(ns / 1000000000ull), (long)(ns % 1000000000ull) };
+    nanosleep( &ts, NULL );
+}
+
+/* Running as translated x86 code (Rosetta)? 0 natively, and on an Intel Mac. */
+static inline int bw_pacer_translated(void)
+{
+    int value = 0;
+    size_t size = sizeof(value);
+    if (sysctlbyname( "sysctl.proc_translated", &value, &size, NULL, 0 )) return 0;
+    return value == 1;
+}
+
+static inline unsigned bw_pacer_clamp_bytes( unsigned bytes )
+{
+    if (!bytes) return 16384;
+    if (bytes < 2048) return 2048;
+    if (bytes > 65536) return 65536;
+    return bytes;
+}
+
+/* BW_PACER: "auto", "off"/"0", or "<duty>[,<bytes>]". Returns 0 when no thread is wanted. */
+static inline int bw_pacer_parse( const char *value, struct bw_pacer *p )
+{
+    unsigned duty = 0, bytes = 0;
+    memset( p, 0, sizeof(*p) );
+    if (!value || !*value) return 0;
+    if (!strcasecmp( value, "off" )) return 0;
+    if (!strncasecmp( value, "auto", 4 ))
+    {
+        p->automatic = 1;
+        p->duty = 40;                   /* where MacGameFix's player found the best compromise on an M4 Max */
+        p->min_duty = 10;
+        p->max_duty = 60;               /* from about 65 up the game's own short pause grows (MacGameFix, M4 Max) */
+        if (value[4] == ',') bytes = (unsigned)strtoul( value + 5, NULL, 10 );
+        p->bytes = bw_pacer_clamp_bytes( bytes );
+        return 1;
+    }
+    if (sscanf( value, "%u,%u", &duty, &bytes ) < 1 || !duty) return 0;
+    p->duty = duty > 100 ? 100 : duty;
+    p->min_duty = p->max_duty = p->duty;
+    p->bytes = bw_pacer_clamp_bytes( bytes );
+    return 1;
+}
+
+/* One function never seen before: mov eax, <unique>; popcnt eax, ecx ... ; ret. The unique constant makes every
+ * function new to the translator; popcnt is short, register-only and translates to one instruction. */
+static inline void bw_pacer_make( unsigned char *code, unsigned bytes, uint32_t unique )
+{
+    static const unsigned char body[4] = { 0xf3, 0x0f, 0xb8, 0xc1 };   /* popcnt eax, ecx */
+    unsigned n = 0;
+    code[n++] = 0xb8; memcpy( code + n, &unique, 4 ); n += 4;          /* mov eax, imm32 */
+    while (n + sizeof(body) + 1 <= bytes) { memcpy( code + n, body, sizeof(body) ); n += sizeof(body); }
+    code[n] = 0xc3;                                                      /* ret */
+}
+
+/* The auto rule, once per window: stops of 60 ms or more raise the duty by 10 (the translator needs more help);
+ * two windows in a row whose longest stop stayed under 35 ms lower it by 5 (give the translator back to the game). */
+static inline void bw_pacer_decide( struct bw_pacer *p )
+{
+    if (!p->automatic) return;
+    if (p->window_longest_ns >= 60000000ull)
+    {
+        p->duty = p->duty + 10 > p->max_duty ? p->max_duty : p->duty + 10;
+        p->quiet_windows = 0;
+    }
+    else if (p->window_longest_ns < 35000000ull)
+    {
+        if (++p->quiet_windows >= 2)
+        {
+            p->duty = p->duty < p->min_duty + 5 ? p->min_duty : p->duty - 5;
+            p->quiet_windows = 0;
+        }
+    }
+    else p->quiet_windows = 0;
+    p->window_longest_ns = 0;
+}
+
+static void *bw_pacer_thread( void *arg )
+{
+    struct bw_pacer *p = arg;
+    unsigned char *region = mmap( NULL, BW_PACER_REGION, PROT_READ | PROT_WRITE | PROT_EXEC,
+                                  MAP_PRIVATE | MAP_ANON, -1, 0 );
+    uint64_t window_start = bw_pacer_now(), log_start = window_start;
+    unsigned long long made_logged = 0, stops_logged = 0;
+    size_t offset = 0;
+    uint32_t unique = 1;
+
+    sigset_t all;
+
+    /* Not a Wine thread: no signal Wine handles may ever land here (its handlers expect a thread it made) */
+    sigfillset( &all );
+    pthread_sigmask( SIG_BLOCK, &all, NULL );
+    if (region == MAP_FAILED)
+    {
+        fprintf( stderr, "bw-pacer: no executable memory for the pacer; off\n" );
+        return NULL;
+    }
+    fprintf( stderr, "bw-pacer: on (%s, duty %u%%, functions of %u bytes)\n",
+             p->automatic ? "auto" : "fixed", p->duty, p->bytes );
+    for (;;)
+    {
+        uint64_t slice = bw_pacer_now(), now;
+        do
+        {
+            uint64_t t0, took;
+            unsigned char *code;
+            if (offset + p->bytes > BW_PACER_REGION) offset = 0;
+            code = region + offset;
+            offset += p->bytes;
+            t0 = bw_pacer_now();
+            bw_pacer_make( code, p->bytes, unique );
+            unique += 3;
+            ((uint32_t (*)(void))code)();
+            took = bw_pacer_now() - t0;
+            p->made++;
+            if (took >= BW_PACER_STOP_NS) p->stops++;
+            if (took > p->longest_ns) p->longest_ns = took;
+            if (took > p->window_longest_ns) p->window_longest_ns = took;
+            now = bw_pacer_now();
+        } while ((now - slice) * 100 < (uint64_t)p->duty * BW_PACER_SLICE_NS);
+        if (p->duty < 100) bw_pacer_sleep_ns( BW_PACER_SLICE_NS * (100 - p->duty) / 100 );
+
+        now = bw_pacer_now();
+        if (now - window_start >= BW_PACER_WINDOW) { bw_pacer_decide( p ); window_start = now; }
+        if (now - log_start >= 10000000000ull)
+        {
+            fprintf( stderr, "bw-pacer: duty %u%%, %llu functions, %llu translator stops seen (longest %llu ms)\n",
+                     p->duty, p->made - made_logged, p->stops - stops_logged, p->longest_ns / 1000000 );
+            made_logged = p->made; stops_logged = p->stops; p->longest_ns = 0; log_start = now;
+        }
+    }
+    return NULL;
+}
+
+/* Starts the pacer when BW_PACER asks for it, the process is translated by Rosetta, and `exe` (the main program's
+ * file name, or NULL to skip the check) is the one BW_PACER_EXE names. Returns 1 when a thread was started. */
+static inline int bw_pacer_start( const char *exe )
+{
+    static struct bw_pacer pacer;
+    const char *want = getenv( "BW_PACER_EXE" );
+    pthread_attr_t attr;
+    pthread_t thread;
+
+    if (!bw_pacer_parse( getenv( "BW_PACER" ), &pacer )) return 0;
+    if (!want || !*want) want = "forzahorizon6.exe";
+    if (exe && strcasecmp( exe, want )) return 0;
+    if (!bw_pacer_translated()) return 0;
+    pthread_attr_init( &attr );
+    pthread_attr_setdetachstate( &attr, PTHREAD_CREATE_DETACHED );
+    if (pthread_create( &thread, &attr, bw_pacer_thread, &pacer )) { pthread_attr_destroy( &attr ); return 0; }
+    pthread_attr_destroy( &attr );
+    return 1;
+}
+
+#endif /* BW_PACER_H */
diff -ruN a/dlls/ntdll/unix/bw_trapboost.h b/dlls/ntdll/unix/bw_trapboost.h
--- a/dlls/ntdll/unix/bw_trapboost.h	1970-01-01 01:00:00
+++ b/dlls/ntdll/unix/bw_trapboost.h	2026-11-21 12:30:42
@@ -0,0 +1,114 @@
+/*
+ * Blackwell Trap Boost: Rosetta's exception server, given the priority the game's traps need.
+ *
+ * Every hardware exception translated x86_64 code takes (ud2 and the other invalid instructions Forza Horizon 6's
+ * protection executes in waves, int3, writes into translated pages) is serviced by one thread per process,
+ * com.apple.rosetta.exceptionserver, at default priority. With the game keeping the cores busy, that thread waits for
+ * a core on every trap. Found and measured by Mathias Kowoll for MacGameFix (NotProton's rosetta-trap-boost plugin:
+ * on an M4 Max with 14 busy threads, a trap's round trip took 42-88 us against an 18.6 us floor), where it is a
+ * library injected into the process. Here it is Blackwell Engine's own code, in Wine's ntdll: one thread looks for
+ * the exception server by name and raises it to the latency and throughput tiers, and the precedence, of a highest-
+ * priority thread, then checks every few seconds that it stays there. No Wine thread and no game code is touched.
+ *
+ *   BW_TRAP_BOOST=1   on (MetalHorizon's beta engine sets it); unset or 0: nothing starts.
+ * Started by bw_trapboost_start() only in the program BW_PACER_EXE names (forzahorizon6.exe by default), and only
+ * when Rosetta translates the process. One line on stderr when the server is raised.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef BW_TRAPBOOST_H
+#define BW_TRAPBOOST_H
+
+#include <mach/mach.h>
+#include <mach/thread_policy.h>
+#include <pthread.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/sysctl.h>
+#include <unistd.h>
+
+#define BW_TRAPBOOST_SERVER "com.apple.rosetta.exceptionserver"
+
+static inline int bw_trapboost_translated(void)
+{
+    int value = 0;
+    size_t size = sizeof(value);
+    return !sysctlbyname( "sysctl.proc_translated", &value, &size, NULL, 0 ) && value == 1;
+}
+
+/* The tiers and precedence of a thread that must never wait for a core while the game's threads keep them busy. */
+static inline int bw_trapboost_raise( thread_act_t thread )
+{
+    integer_t latency = LATENCY_QOS_TIER_0, throughput = THROUGHPUT_QOS_TIER_0;
+    thread_extended_policy_data_t timeshare = { 1 };
+    thread_precedence_policy_data_t precedence = { 5 };
+    kern_return_t kr = thread_policy_set( thread, THREAD_LATENCY_QOS_POLICY, (thread_policy_t)&latency,
+                                          THREAD_LATENCY_QOS_POLICY_COUNT );
+    thread_policy_set( thread, THREAD_THROUGHPUT_QOS_POLICY, (thread_policy_t)&throughput, THREAD_THROUGHPUT_QOS_POLICY_COUNT );
+    thread_policy_set( thread, THREAD_EXTENDED_POLICY, (thread_policy_t)&timeshare, THREAD_EXTENDED_POLICY_COUNT );
+    thread_policy_set( thread, THREAD_PRECEDENCE_POLICY, (thread_policy_t)&precedence, THREAD_PRECEDENCE_POLICY_COUNT );
+    return kr == KERN_SUCCESS;
+}
+
+/* Raises every thread of this task named like Rosetta's exception server. Returns how many were raised. */
+static inline int bw_trapboost_once(void)
+{
+    thread_act_array_t threads;
+    mach_msg_type_number_t count = 0, i;
+    int raised = 0;
+
+    if (task_threads( mach_task_self(), &threads, &count ) != KERN_SUCCESS) return 0;
+    for (i = 0; i < count; i++)
+    {
+        thread_extended_info_data_t info;
+        mach_msg_type_number_t size = THREAD_EXTENDED_INFO_COUNT;
+        if (thread_info( threads[i], THREAD_EXTENDED_INFO, (thread_info_t)&info, &size ) == KERN_SUCCESS &&
+            !strncmp( info.pth_name, BW_TRAPBOOST_SERVER, sizeof(info.pth_name) ) && bw_trapboost_raise( threads[i] ))
+            raised++;
+        mach_port_deallocate( mach_task_self(), threads[i] );
+    }
+    vm_deallocate( mach_task_self(), (vm_address_t)threads, count * sizeof(*threads) );
+    return raised;
+}
+
+static void *bw_trapboost_thread( void *arg )
+{
+    sigset_t all;
+    int said = 0;
+    (void)arg;
+    /* Not a Wine thread: no signal Wine handles may ever land here */
+    sigfillset( &all );
+    pthread_sigmask( SIG_BLOCK, &all, NULL );
+    for (;;)
+    {
+        /* the server appears with the process's first exception: looked for every second until found, then kept
+         * raised every five seconds */
+        int raised = bw_trapboost_once();
+        if (raised && !said) { fprintf( stderr, "bw-trapboost: Rosetta's exception server raised\n" ); said = 1; }
+        sleep( said ? 5 : 1 );
+    }
+    return NULL;
+}
+
+/* Starts when BW_TRAP_BOOST=1, the process is translated by Rosetta and `exe` (the main program's file name, or NULL
+ * to skip the check) is the one BW_PACER_EXE names. Returns 1 when a thread was started. */
+static inline int bw_trapboost_start( const char *exe )
+{
+    const char *on = getenv( "BW_TRAP_BOOST" ), *want = getenv( "BW_PACER_EXE" );
+    pthread_attr_t attr;
+    pthread_t thread;
+
+    if (!on || strcmp( on, "1" )) return 0;
+    if (!want || !*want) want = "forzahorizon6.exe";
+    if (exe && strcasecmp( exe, want )) return 0;
+    if (!bw_trapboost_translated()) return 0;
+    pthread_attr_init( &attr );
+    pthread_attr_setdetachstate( &attr, PTHREAD_CREATE_DETACHED );
+    if (pthread_create( &thread, &attr, bw_trapboost_thread, NULL )) { pthread_attr_destroy( &attr ); return 0; }
+    pthread_attr_destroy( &attr );
+    return 1;
+}
+
+#endif /* BW_TRAPBOOST_H */
diff -ruN a/dlls/ntdll/unix/loader.c b/dlls/ntdll/unix/loader.c
