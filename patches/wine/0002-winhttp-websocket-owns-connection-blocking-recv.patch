--- a/dlls/winhttp/request.c
+++ b/dlls/winhttp/request.c
@@ -3545,8 +3545,12 @@
     InitializeSRWLock( &socket->send_lock );
     init_queue( &socket->send_q );
     init_queue( &socket->recv_q );
-    netconn_addref( request->netconn );
+    /* The connection now belongs to the WebSocket alone. Left on the request, a later read of the (empty) 101
+     * response reaches finished_reading, which puts it back in the keep-alive pool: the next request to that
+     * host then reuses it while the WebSocket is still reading from it (netconn_is_alive makes it non-blocking
+     * and consumes its TLS records). */
     socket->netconn = request->netconn;
+    request->netconn = NULL;
 
     netconn_set_timeout( socket->netconn, FALSE, socket->keepalive_interval );
 
