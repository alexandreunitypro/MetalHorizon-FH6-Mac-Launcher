     }
 
-    if ((*recvd = sock_recv( conn->socket, buf, len, flags )) < 0) return WSAGetLastError();
+    if ((*recvd = sock_recv( conn, buf, len, flags )) < 0) return WSAGetLastError();
     return ERROR_SUCCESS;
 }
 
