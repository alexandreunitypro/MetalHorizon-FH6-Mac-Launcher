nsiproxy: skip an ARP entry on an unlisted interface instead of ending the walk; iphlpapi: implement SendARP from the neighbour table.

Forza Horizon 6 calls SendARP on its gateway at startup; Wine answered ERROR_NOT_SUPPORTED. Note: on macOS 27 the kernel no
longer hands IPv4 ARP entries to non-platform processes (Wine included), so the table may still be empty there.

--- a/dlls/nsiproxy.sys/ip.c
+++ b/dlls/nsiproxy.sys/ip.c
@@ -1347,7 +1347,13 @@
             {
                 entry.addr = sinarp->sin_addr;
                 entry.if_index = sdl->sdl_index;
-                if (!convert_index_to_luid( entry.if_index, &entry.luid )) break;
+                /* An entry on an interface we do not list (a bridge, a tunnel) used to end the walk here, dropping
+                 * every neighbour after it -- the default gateway included. Skip just that one. */
+                if (!convert_index_to_luid( entry.if_index, &entry.luid ))
+                {
+                    next += rtm->rtm_msglen;
+                    continue;
+                }
                 entry.phys_addr_len = min( 8, sdl->sdl_alen );
                 if (entry.phys_addr_len > sizeof(entry.phys_addr)) entry.phys_addr_len = 0;
                 memcpy( entry.phys_addr, &sdl->sdl_data[sdl->sdl_nlen], entry.phys_addr_len );
--- a/dlls/iphlpapi/iphlpapi_main.c
+++ b/dlls/iphlpapi/iphlpapi_main.c
@@ -3976,9 +3976,40 @@
  */
 DWORD WINAPI SendARP(IPAddr DestIP, IPAddr SrcIP, PULONG pMacAddr, PULONG PhyAddrLen)
 {
-  FIXME("(DestIP 0x%08lx, SrcIP 0x%08lx, pMacAddr %p, PhyAddrLen %p): stub\n",
-   DestIP, SrcIP, pMacAddr, PhyAddrLen);
-  return ERROR_NOT_SUPPORTED;
+    MIB_IPNETTABLE *table = NULL;
+    ULONG size = 0;
+    DWORD ret, i;
+
+    TRACE( "(DestIP 0x%08lx, SrcIP 0x%08lx, pMacAddr %p, PhyAddrLen %p)\n", DestIP, SrcIP, pMacAddr, PhyAddrLen );
+    if (!pMacAddr || !PhyAddrLen || !*PhyAddrLen) return ERROR_INVALID_PARAMETER;
+
+    /* No ARP request is sent: the answer comes from the system's neighbour cache, which holds the gateway and
+     * every host recently talked to -- what titles ask for (Forza Horizon 6 asks for its gateway's address). */
+    ret = GetIpNetTable( NULL, &size, FALSE );
+    if (ret == ERROR_INSUFFICIENT_BUFFER && (table = malloc( size ))) ret = GetIpNetTable( table, &size, FALSE );
+    if (ret)
+    {
+        free( table );
+        return ret == ERROR_NO_DATA ? ERROR_BAD_NET_NAME : ret;
+    }
+    ret = ERROR_BAD_NET_NAME;
+    for (i = 0; i < table->dwNumEntries; i++)
+    {
+        MIB_IPNETROW *row = &table->table[i];
+        if (row->dwAddr != DestIP || !row->dwPhysAddrLen || row->dwType == MIB_IPNET_TYPE_INVALID) continue;
+        if (*PhyAddrLen < row->dwPhysAddrLen)
+        {
+            *PhyAddrLen = row->dwPhysAddrLen;
+            ret = ERROR_BAD_ARGUMENTS;
+            break;
+        }
+        memcpy( pMacAddr, row->bPhysAddr, row->dwPhysAddrLen );
+        *PhyAddrLen = row->dwPhysAddrLen;
+        ret = NO_ERROR;
+        break;
+    }
+    free( table );
+    return ret;
 }
 
 
