     func( NtStatusToWSAError( io->Status ), io->Information, (OVERLAPPED *)io, 0 );
+}
+
+static BOOL udpreq_wanted( SOCKET s, LONG *counter )
+{
+    int type = 0, len = sizeof(type);
+    LONG n;
+
+    if (!TRACE_ON(udpreq)) return FALSE;
+    if (getsockopt( s, SOL_SOCKET, SO_TYPE, (char *)&type, &len ) || type != SOCK_DGRAM) return FALSE;
+    n = InterlockedIncrement( counter );
+    return n <= 300 || !(n % 500);  /* the start of every exchange, then a sample */
 }
 
