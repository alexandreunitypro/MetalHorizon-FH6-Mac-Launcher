-#[cfg(not(target_os = "linux"))]
+/// On macOS the decrypted image goes to a file on the private RAM disk that
+/// `prepare` mounts, and that file keeps its name until the disk is detached.
+///
+/// macOS has no memfd and no /proc. Wine gives every handle a title opens on
+/// its own image a file position of its own by reopening the descriptor, and
+/// without /proc the only way to do that is through the file's name
+/// (fcntl(F_GETPATH), see the Wine half of this change). An anonymous
+/// tempfile has no name to reopen, so every handle shared one position: a
+/// title that reads its own executable to the end and opens it again reads
+/// nothing the second time, and one that hashes it stops itself.
+///
+/// The plaintext still never reaches a persistent disk: the RAM disk is
+/// mounted nobrowse in a private temporary directory and force-detached when
+/// the game exits, which removes the file with it.
+#[cfg(target_os = "macos")]
+fn make_temp_file(folder: &str, _name: &str) -> std::io::Result<std::fs::File> {
+    if folder.is_empty() {
+        return tempfile();
+    }
+    let (file, _path) = Builder::new()
+        .prefix("xodus-image-")
+        .tempfile_in(folder)?
+        .keep()
+        .map_err(|e| e.error)?;
+    Ok(file)
+}
