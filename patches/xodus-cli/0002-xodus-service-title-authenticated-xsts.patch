//! Feasibility probe for Forza Horizon 6 online services (no game needed). Prints no token.
//! 1. SISU as the game's own app (MSAAppId 000000004CE146F7, title 2079757188): device + title + user tokens
//! 2. the title's own endpoint list (NSAL), read with that title-bearing token
//! 3. an XSTS token with device + title + user for every non-Microsoft relying party in it
use xal::RequestSigning;

#[tokio::main]
async fn main() {
    let client = reqwest::Client::new();
    xodus::secrets::init_secrets().expect("keychain");
    let tokens = xodus::tokens::TokenManager::with_keychain_and_memory();
    let (mut auth, sisu, device) =
        match xodus::auth::do_sisu(&client, &tokens, "000000004CE146F7", 2079757188).await {
            Ok(v) => v,
            Err(e) => { println!("SISU FAILED: {e}"); return; }
        };
    let xui = sisu.authorization_token.display_claims.as_ref().and_then(|c| c.xui.first().cloned()).unwrap_or_default();
    println!("SISU ok: title token {} chars, gamertag {:?}", sisu.title_token.token.len(), xui.get("gtg"));
    let uhs = xui.get("uhs").cloned().unwrap_or_default();
    let header = format!("XBL3.0 x={uhs};{}", sisu.authorization_token.token);

    let mut signer = auth.request_signer();
    let mut rps: Vec<(String, String)> = Vec::new();
    let urls = ["https://title.mgt.xboxlive.com/titles/2079757188/endpoints",
                "https://title.mgt.xboxlive.com/titles/2079757188/endpoints?type=2",
                "https://title.mgt.xboxlive.com/titles/current/endpoints?type=1",
                "https://title.mgt.xboxlive.com/titles/current/endpoints"];
    for url in urls { for signed in [false] {
        let mut req = client.get(url).header("Authorization", &header).header("x-xbl-contract-version", "1").build().unwrap();
        if signed {
            // sign with the key the SISU tokens are bound to (xal signs http::Request; copy its Signature header over)
            let hreq = xal::oauth2::http::Request::builder().method("GET").uri(url)
                .header("Authorization", &header).header("x-xbl-contract-version", "1").body(Vec::<u8>::new()).unwrap();
            match signer.sign_request(hreq, None).await {
                Ok(r) => match r.headers().get("Signature") {
                    Some(sig) => { req.headers_mut().insert("Signature", sig.to_str().unwrap().parse().unwrap()); }
                    None => { println!("(no signature policy for the NSAL url)"); continue; }
                },
                Err(e) => { println!("(signing NSAL request failed: {e})"); continue; }
            }
        }
        let resp = client.execute(req).await.expect("NSAL request");
        let status = resp.status();
        let text = resp.text().await.unwrap_or_default();
        println!("title NSAL {url}: HTTP {status}, {} bytes", text.len());
        if !status.is_success() { continue; }
        let v: serde_json::Value = serde_json::from_str(&text).unwrap_or_default();
        for e in v["EndPoints"].as_array().cloned().unwrap_or_default() {
            let host = e["Host"].as_str().unwrap_or("");
            if host.contains("xboxlive.com") || host.contains("microsoft.com") || host.contains("xboxservices.com") { continue; }
            println!("  endpoint {e}");
            if let Some(rp) = e["RelyingParty"].as_str() { rps.push((host.to_string(), rp.to_string())); }
        }
    } }
    rps.sort(); rps.dedup();
    for (host, rp) in rps {
        let user_only = auth.get_xsts_token(None, None, Some(&sisu.user_token), &rp).await;
        let full = auth.get_xsts_token(Some(&device), Some(&sisu.title_token), Some(&sisu.user_token), &rp).await;
        println!("XSTS {host} -> {rp}: user-only {} | device+title+user {}",
            user_only.as_ref().map(|_| "OK".to_string()).unwrap_or_else(|e| format!("FAIL {e}")),
            full.as_ref().map(|_| "OK".to_string()).unwrap_or_else(|e| format!("FAIL {e}")));
    }

    // what the Forza server answers to each kind of token (status only)
    let target = "https://gameservices.fh6.forzamotorsport.net/Services/o.xtsw";
    let mut cases: Vec<(&str, Option<String>)> = vec![("no token", None)];
    for (label, rp, full) in [("xboxlive.com RP (what xodus sends today)", "http://xboxlive.com", false),
                              ("forza RP, user only", "http://xboxliveauth.forzamotorsport.net/", false),
                              ("forza RP, device+title+user", "http://xboxliveauth.forzamotorsport.net/", true)] {
        let t = if full { auth.get_xsts_token(Some(&device), Some(&sisu.title_token), Some(&sisu.user_token), rp).await }
                else { auth.get_xsts_token(None, None, Some(&sisu.user_token), rp).await };
        match t {
            Ok(t) => { let uhs = t.display_claims.as_ref().and_then(|c| c.xui.first()).and_then(|x| x.get("uhs").cloned()).unwrap_or_default();
                       cases.push((label, Some(format!("XBL3.0 x={uhs};{}", t.token)))); }
            Err(e) => println!("{label}: no token ({e})"),
        }
    }
    for (label, h) in cases {
        for method in ["GET", "POST"] {
            let mut rb = if method == "GET" { client.get(target) } else { client.post(target).body(Vec::<u8>::new()) };
            if let Some(h) = &h { rb = rb.header("Authorization", h); }
            match rb.send().await {
                Ok(r) => { let st = r.status(); let hdr: Vec<String> = r.headers().iter().filter(|(k, _)| k.as_str().starts_with("www-auth") || k.as_str().starts_with("x-")).map(|(k, v)| format!("{k}={}", v.to_str().unwrap_or("?"))).collect();
                           let body = r.text().await.unwrap_or_default();
                           println!("forza {method} [{label}]: HTTP {st} {:?} body {:?}", hdr, body.chars().take(160).collect::<String>()); }
                Err(e) => println!("forza {method} [{label}]: error {e}"),
            }
        }
    }
}
