+/// What Windows' Xbox identity provider holds for a title: the SISU session of its own MSAAppId
+/// (device + title + user tokens, bound to the authenticator's signing key) and the title's own
+/// endpoint list. Tokens minted from it carry the title's claims, which title services check:
+/// Forza Horizon 6's game server sits on *.forzamotorsport.net, whose relying party
+/// (http://xboxliveauth.forzamotorsport.net/) only the title's list names -- the default list does
+/// not, so the game was handed an http://xboxlive.com token and reported its server unavailable.
+struct TitleSession {
+    auth: xal::XalAuthenticator,
+    /// The key the SISU tokens are bound to, in the form the service signs with.
+    signer: Option<xodus::api::xbox::RequestSigner>,
+    device: xal::response::DeviceToken,
+    sisu: xal::response::SisuRPSAuthorizationResponse,
+    endpoints: Option<xodus::models::xbox::TitleMgtResponse>,
+}
+
+static TITLE_SESSIONS: std::sync::LazyLock<
+    tokio::sync::Mutex<std::collections::HashMap<(String, i64), TitleSession>>,
+> = std::sync::LazyLock::new(|| tokio::sync::Mutex::new(std::collections::HashMap::new()));
+
+fn xbl_header(token: &xal::response::XSTSToken) -> String {
+    let uhs = token
+        .display_claims
+        .as_ref()
+        .and_then(|c| c.xui.first())
+        .and_then(|x| x.get("uhs").cloned())
+        .unwrap_or_default();
+    format!("XBL3.0 x={uhs};{}", token.token)
+}
+
+async fn new_title_session(
+    context: &SimpleContext,
+    client_id: &str,
+    title_id: i64,
+) -> Result<TitleSession, Box<dyn std::error::Error + Send + Sync>> {
+    let (auth, sisu, device) = xodus::auth::do_sisu(&context.client, context.tokens(), client_id, title_id)
+        .await
+        .map_err(|e| e.to_string())?;
+    // The title's list answers to its own token, without the ?type=1 the default list takes.
+    let endpoints = async {
+        let resp = context
+            .client
+            .get(format!("https://title.mgt.xboxlive.com/titles/{title_id}/endpoints"))
+            .header("Authorization", xbl_header(&sisu.authorization_token))
+            .header("x-xbl-contract-version", "1")
+            .send()
+            .await
+            .ok()?
+            .error_for_status()
+            .ok()?;
+        resp.json::<xodus::models::xbox::TitleMgtResponse>().await.ok()
+    }
+    .await;
+    tracing::info!(
+        "Title {title_id} signed in as {client_id}; its endpoint list has {} entries",
+        endpoints.as_ref().map_or(0, |e| e.end_points.len())
+    );
+    let signer = {
+        use p256::pkcs8::EncodePrivateKey;
+        auth.request_signer()
+            .keypair
+            .to_pkcs8_der()
+            .ok()
+            .and_then(|der| xodus::api::xbox::RequestSigner::from_pkcs8(der.as_bytes()))
+    };
+    Ok(TitleSession { auth, signer, device, sisu, endpoints })
+}
+
+/// The relying party a title's own list gives this URL, ignoring its catch-all "*" entries.
+fn title_relying_party(url: &str, endpoints: &Option<xodus::models::xbox::TitleMgtResponse>) -> Option<String> {
+    let list = endpoints.as_ref()?;
+    let endpoint = xodus::api::xbox::title::get_endpoint(url, list)?;
+    if endpoint.host == "*" {
+        return None;
+    }
+    endpoint.relying_party.clone()
+}
+
+/// A token minted as the title, or None when that is not possible (the caller falls back to the
+/// user-only token, which is what every request got before).
+async fn title_token(
+    context: &SimpleContext,
+    req: &XSTSTokenRequest,
+    default_relying_party: impl std::future::Future<Output = String>,
+) -> Option<XSTSTokenResponse> {
+    if req.title_client_id.is_empty() {
+        return None;
+    }
+    let title_id = req.title_id.trim().parse::<i64>().ok()?;
+    let key = (req.title_client_id.clone(), title_id);
+    let mut sessions = TITLE_SESSIONS.lock().await;
+    let now = chrono::Utc::now();
+    let stale = sessions.get(&key).is_none_or(|s| {
+        s.sisu.title_token.not_after < now + chrono::Duration::minutes(5)
+            || s.sisu.user_token.not_after < now + chrono::Duration::minutes(5)
+            || s.device.not_after < now + chrono::Duration::minutes(5)
+    });
+    if stale {
+        match new_title_session(context, &req.title_client_id, title_id).await {
+            Ok(session) => {
+                sessions.insert(key.clone(), session);
+            }
+            Err(err) => {
+                tracing::warn!("Title sign-in for {title_id} failed, using the user token: {err}");
+                sessions.remove(&key);
+                return None;
+            }
+        }
+    }
+    let session = sessions.get_mut(&key)?;
+
+    let relying_party = if !req.relying_party.is_empty() {
+        req.relying_party.clone()
+    } else if let Some(rp) = title_relying_party(&req.url, &session.endpoints) {
+        rp
+    } else {
+        default_relying_party.await
+    };
+    let cache_key = format!("{relying_party}|title={title_id}");
+    let now_ts = now.timestamp();
+    let cached = XSTS_CACHE
+        .lock()
+        .ok()
+        .and_then(|c| c.get(&cache_key).cloned())
+        .filter(|c| c.expiry > now_ts + 60);
+    let hit = match cached {
+        Some(hit) => hit,
+        None => {
+            let xsts = match session
+                .auth
+                .get_xsts_token(
+                    Some(&session.device),
+                    Some(&session.sisu.title_token),
+                    Some(&session.sisu.user_token),
+                    &relying_party,
+                )
+                .await
+            {
+                Ok(t) => t,
+                Err(err) => {
+                    tracing::warn!("Title XSTS for {relying_party} failed, using the user token: {err}");
+                    return None;
+                }
+            };
+            let xui = xsts.display_claims.as_ref().and_then(|c| c.xui.first());
+            let token = CachedToken {
+                token: xbl_header(&xsts),
+                xuid: xui.and_then(|x| x.get("xid").cloned()).unwrap_or_default(),
+                gamertag: xui.and_then(|x| x.get("gtg").cloned()).unwrap_or_default(),
+                expiry: xsts.not_after.timestamp(),
+            };
+            if let Ok(mut cache) = XSTS_CACHE.lock() {
+                cache.insert(cache_key, token.clone());
+            }
+            token
+        }
+    };
+    tracing::debug!("Title token for {} ({relying_party})", req.url);
+
+    // Signed with the key these tokens are bound to, under the same policies as before; endpoints
+    // without a policy need no signature.
+    let signature = match (&session.signer, signature_policy(&req.url, &endpoints_for(&context.client).await)) {
+        (Some(signer), Some((version, max_body))) => {
+            let body = if req.body_base64.is_empty() {
+                Vec::new()
+            } else {
+                base64::Engine::decode(&base64::engine::general_purpose::STANDARD, &req.body_base64)
+                    .unwrap_or_default()
+            };
+            let method = if req.method.is_empty() { "GET" } else { &req.method };
+            signer.sign(version, method, &xodus::api::xbox::path_and_query(&req.url), &hit.token, &body, max_body)
+        }
+        _ => String::new(),
+    };
+    Some(XSTSTokenResponse {
+        token: hit.token,
+        xuid: hit.xuid,
+        gamertag: hit.gamertag,
+        expiry: hit.expiry,
+        signature,
+    })
+}
+
