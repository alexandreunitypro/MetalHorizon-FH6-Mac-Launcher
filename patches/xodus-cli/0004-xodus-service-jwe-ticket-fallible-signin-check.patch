+/// The Xbox sign-in for one relying party, as a result instead of a panic: the Microsoft ticket exchange, the Xbox
+/// user token, then the XSTS token. A refusal or a network error is tried again twice, a few seconds apart (Xbox
+/// Live answers 5xx or times out at times); what it answered is in the error.
+pub async fn try_run_with_signer(
+    client: &reqwest::Client,
+    dev_token: LegacyToken,
+    legacy: LegacyToken,
+    relying_party: &str,
+    signer: Option<&signing::RequestSigner>,
+) -> Result<XstsResponse, String> {
+    let mut last = String::new();
+    for attempt in 1..=3u32 {
+        match attempt_run(client, dev_token.clone(), legacy.clone(), relying_party, signer).await {
+            Ok(xsts) => return Ok(xsts),
+            Err(err) => {
+                eprintln!("Xbox sign-in for {relying_party}, attempt {attempt} of 3: {err}");
+                last = err;
+            }
+        }
+        if attempt < 3 {
+            tokio::time::sleep(std::time::Duration::from_secs(2 * attempt as u64)).await;
+        }
+    }
+    Err(last)
+}
+
