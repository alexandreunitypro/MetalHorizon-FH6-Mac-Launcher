+/// A refused request says why in its headers and body (an XErr code, a message): logged, with no token in it, so a
+/// failure is no longer a bare "Status(400, None)".
+async fn explain_failure(resp: reqwest::Response, what: &str) -> reqwest::Result<reqwest::Response> {
+    if resp.status().is_success() {
+        return Ok(resp);
+    }
+    let err = resp.error_for_status_ref().unwrap_err();
+    let status = resp.status();
+    let www = resp
+        .headers()
+        .get("www-authenticate")
+        .and_then(|v| v.to_str().ok())
+        .unwrap_or("")
+        .to_owned();
+    let body = resp.text().await.unwrap_or_default();
+    let body: String = body.chars().take(600).collect();
+    eprintln!("Xbox answered {status} to {what}: {body} {www}");
+    Err(err)
+}
