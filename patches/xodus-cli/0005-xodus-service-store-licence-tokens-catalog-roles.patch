+    #[test]
+    fn only_a_well_formed_token_is_handed_over() {
+        assert_eq!(parse_response(br#"{"licenseToken":"aaa.bbb.ccc"}"#).unwrap(), "aaa.bbb.ccc");
+        assert!(parse_response(br#"{"licenseToken":""}"#).is_err());
+        assert!(parse_response(br#"{"licenseToken":"a b"}"#).is_err());
+        assert!(parse_response(b"<html>").is_err());
+    }
+}
