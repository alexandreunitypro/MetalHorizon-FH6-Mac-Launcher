+//! The player's gamer picture, for XUserGetGamerPictureAsync (GSDX frames).
+//!
+//! The runtime used to hand every title a neutral grey square: Forza Horizon 6 aborted when the call failed, and the
+//! picture itself needs the Xbox profile service. So players saw a grey profile picture (issue #18). This asks
+//! profile.xboxlive.com for the account's GameDisplayPicRaw setting (the picture's address, on Xbox's image service)
+//! with the user's Xbox token, fetches it as a PNG of the size asked for, and keeps it for the life of the service.
+//!
+//! Frame: "GSDX", then [version 1, size in pixels] as two u32; the answer is "GSDX", [status, length] as two u32 and
+//! the PNG (status 0), or status 1 and no bytes: the runtime then keeps its grey square.
+use std::collections::HashMap;
+use std::sync::{Arc, Mutex};
+use std::time::Duration;
+
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use xodus::models::xgameruntime::xuser::XSTSTokenRequest;
+
+use crate::simple_context::SimpleContext;
+
+pub(super) const MAGIC: u32 = 0x58445347; // "GSDX"
+const PROFILE: &str = "https://profile.xboxlive.com/users/me/profile/settings?settings=GameDisplayPicRaw";
+const MAX_IMAGE: usize = 4 * 1024 * 1024;
+
+static CACHE: Mutex<Option<HashMap<u32, Arc<Vec<u8>>>>> = Mutex::new(None);
+
+/// The sizes Xbox's image service is asked for, from what XUserGamerPictureSize stands for (64, 208, 424, 1080).
+pub(super) fn pixels(asked: u32) -> u32 {
+    match asked {
+        0..=64 => 64,
+        65..=208 => 208,
+        209..=424 => 424,
+        _ => 1080,
+    }
+}
+
+/// The picture's address in the profile service's answer, as a PNG of `px` pixels a side. The address often carries
+/// its own `format` (and sometimes a size) already: those are replaced, not repeated (MetalHorizon 2.1.0 added a
+/// second `format=png` and the image service answered something else, issue #15). An http address is asked over https
+/// (images-eds.xboxlive.com answers there as images-eds-ssl.xboxlive.com).
+pub(super) fn picture_url(profile: &str, px: u32) -> Result<String, String> {
+    let value: serde_json::Value =
+        serde_json::from_str(profile).map_err(|_| "the profile answer is not JSON".to_string())?;
+    let raw = value["profileUsers"]
+        .as_array()
+        .and_then(|users| users.first())
+        .and_then(|user| user["settings"].as_array())
+        .and_then(|settings| settings.iter().find(|s| s["id"] == "GameDisplayPicRaw"))
+        .and_then(|s| s["value"].as_str())
+        .filter(|u| !u.is_empty())
+        .ok_or_else(|| "the profile has no gamer picture".to_string())?;
+    let secure = match raw.strip_prefix("http://") {
+        Some(rest) => format!("https://{rest}"),
+        None => raw.to_string(),
+    }
+    .replacen("https://images-eds.xboxlive.com/", "https://images-eds-ssl.xboxlive.com/", 1);
+    let mut url = reqwest::Url::parse(&secure).map_err(|_| "the gamer picture's address is not a URL".to_string())?;
+    if url.scheme() != "https" {
+        return Err("the gamer picture's address is not https".into());
+    }
+    let kept: Vec<(String, String)> = url
+        .query_pairs()
+        .filter(|(k, _)| !matches!(k.as_ref(), "format" | "w" | "h"))
+        .map(|(k, v)| (k.into_owned(), v.into_owned()))
+        .collect();
+    url.query_pairs_mut()
+        .clear()
+        .extend_pairs(kept)
+        .append_pair("format", "png")
+        .append_pair("w", &px.to_string())
+        .append_pair("h", &px.to_string());
+    Ok(url.to_string())
+}
+
+fn is_png(bytes: &[u8]) -> bool {
+    bytes.starts_with(&[0x89, b'P', b'N', b'G', 0x0d, 0x0a, 0x1a, 0x0a])
+}
+
+/// An image the runtime can hand the game as it is: a PNG, or a JPEG, GIF, WebP or BMP converted to one by macOS's own
+/// image tool (sips), at the size asked. Anything else is refused, with what it looked like.
+fn as_png(bytes: &[u8], px: u32) -> Result<Vec<u8>, String> {
+    if is_png(bytes) {
+        return Ok(bytes.to_vec());
+    }
+    let image = bytes.starts_with(&[0xff, 0xd8, 0xff])
+        || bytes.starts_with(b"GIF8")
+        || bytes.starts_with(b"BM")
+        || (bytes.len() > 12 && &bytes[..4] == b"RIFF" && &bytes[8..12] == b"WEBP");
+    if !image {
+        let head: Vec<String> = bytes.iter().take(8).map(|b| format!("{b:02x}")).collect();
+        return Err(format!("the image service answered {} bytes that are not an image ({})", bytes.len(), head.join(" ")));
+    }
+    let dir = std::env::temp_dir().join(format!("xodus-picture-{}", uuid::Uuid::new_v4().simple()));
+    std::fs::create_dir_all(&dir).map_err(|e| e.to_string())?;
+    let (input, output) = (dir.join("picture"), dir.join("picture.png"));
+    let converted = std::fs::write(&input, bytes)
+        .map_err(|e| e.to_string())
+        .and_then(|_| {
+            std::process::Command::new("/usr/bin/sips")
+                .args(["-s", "format", "png", "-z", &px.to_string(), &px.to_string()])
+                .arg(&input)
+                .arg("--out")
+                .arg(&output)
+                .stdout(std::process::Stdio::null())
+                .stderr(std::process::Stdio::null())
+                .status()
+                .map_err(|e| format!("sips: {e}"))
+        })
+        .and_then(|status| if status.success() { std::fs::read(&output).map_err(|e| e.to_string()) } else { Err("sips refused the image".into()) });
+    let _ = std::fs::remove_dir_all(&dir);
+    let png = converted?;
+    if is_png(&png) { Ok(png) } else { Err("the converted picture is not a PNG".into()) }
+}
+
+async fn fetch(context: &SimpleContext, px: u32) -> Result<Arc<Vec<u8>>, String> {
+    if let Ok(cache) = CACHE.lock()
+        && let Some(hit) = cache.as_ref().and_then(|c| c.get(&px))
+    {
+        return Ok(hit.clone());
+    }
+    let auth = super::xml::xsts_response(
+        context,
+        &XSTSTokenRequest {
+            url: PROFILE.into(),
+            relying_party: String::new(),
+            method: "GET".into(),
+            body_base64: String::new(),
+            title_id: String::new(),
+            title_client_id: String::new(),
