--- a/crates/xodus-service/src/connection/license.rs	1970-01-01 01:00:00
+++ b/crates/xodus-service/src/connection/license.rs	2026-11-20 13:17:14
@@ -0,0 +1,199 @@
+//! Store licence tokens (`XStoreQueryLicenseTokenAsync`), asked by the runtime with message type 7.
+//!
+//! The game hands the token to its own servers, which read from it what the account owns: for Forza Horizon 6 the
+//! VIP membership, the Car Pass and the expansions of a Premium edition. Without it they see none of that (issue
+//! #18: "VIP status not showing, car pass cars"). The flow is Ferestre's (icex/xodus, `connection/license.rs`, GPL-3.0
+//! like the rest of xodus), whose xgameruntime this engine runs: `POST /v8.0/licenseToken` with the game's Store ID,
+//! `enforceSellableBy`, `relatedProductIds` as a string holding a JSON array, and the title's custom developer string,
+//! authorized and signed with the title's XSTS token for licensing.mp.microsoft.com, as Windows' game runtime does.
+//!
+//! What differs from Ferestre: one account plays and owns here, and the only title this service ever runs is the one
+//! MetalHorizon starts, so the binding is the game's Store ID alone (`XODUS_STORE_PRODUCT`, from its
+//! MicrosoftGame.config). Neither the token nor the authorization behind it is logged.
+use crate::simple_context::SimpleContext;
+use base64::Engine;
+use base64::engine::general_purpose::STANDARD;
+use std::time::Duration;
+use xodus::models::licensing::LicenseTokenResponse;
+use xodus::models::xgameruntime::xuser::{LicenseTokenIpcRequest, XSTSTokenRequest};
+
+pub(super) const URL: &str = "https://licensing.mp.microsoft.com/v8.0/licenseToken";
+const MAX_RESPONSE: usize = 65536;
+/// Fits the reply frame (a 16-bit length) and the runtime's result buffer.
+const MAX_TOKEN: usize = 60000;
+const HTTP_TIMEOUT: Duration = Duration::from_secs(20);
+
+fn valid_product(s: &str) -> bool {
+    matches!(s.len(), 12 | 16) && s.bytes().all(|c| c.is_ascii_alphanumeric())
+}
+
+/// The request's own checks, before anything goes out: Store IDs only, a custom string, and, when the launcher bound
+/// the service to a game, that game's Store ID as the parent.
+fn check(req: &LicenseTokenIpcRequest, bound: Option<&str>) -> Result<(), String> {
+    if !valid_product(&req.parent_product_id) {
+        return Err(format!("{:?} is not a Store product ID", req.parent_product_id));
+    }
+    if req.product_ids.ids.len() > 256 {
+        return Err(format!("{} product IDs in one request", req.product_ids.ids.len()));
+    }
+    if let Some(id) = req.product_ids.ids.iter().find(|id| !valid_product(id)) {
+        return Err(format!("{id:?} is not a Store product ID"));
+    }
+    if let Some(bound) = bound
+        && !req.parent_product_id.eq_ignore_ascii_case(bound)
+    {
+        return Err(format!(
+            "refused a licence token for {:?}: this service answers for {bound}",
+            req.parent_product_id
+        ));
+    }
+    Ok(())
+}
+
+fn body(req: &LicenseTokenIpcRequest) -> Result<Vec<u8>, String> {
+    let custom = STANDARD
+        .decode(&req.custom_base64)
+        .map_err(|_| "the custom developer string is not base64".to_string())?;
+    let custom = std::str::from_utf8(&custom).map_err(|_| "the custom developer string is not UTF-8".to_string())?;
+    if custom.is_empty() {
+        return Err("empty custom developer string".into());
+    }
+    let ids = serde_json::to_string(&req.product_ids.ids).map_err(|e| e.to_string())?;
+    serde_json::to_vec(&serde_json::json!({
+        "parentProductId": req.parent_product_id,
+        "enforceSellableBy": true,
+        "relatedProductIds": ids,
+        "customDeveloperString": custom,
+    }))
+    .map_err(|e| e.to_string())
+}
+
+fn parse_response(bytes: &[u8]) -> Result<String, String> {
+    let response: LicenseTokenResponse =
+        serde_json::from_slice(bytes).map_err(|_| "the licence service's answer is not a token".to_string())?;
+    let token = response.license_token;
+    if token.is_empty()
+        || token.len() > MAX_TOKEN
+        || !token.bytes().all(|c| c.is_ascii_alphanumeric() || b"-_.".contains(&c))
+    {
+        return Err("the licence service answered with an empty or malformed token".into());
+    }
+    Ok(token)
+}
+
+async fn post(url: &str, body: Vec<u8>, authorization: &str, signature: &str) -> Result<String, String> {
+    if authorization.is_empty() {
+        return Err("no XSTS token for the licence service".into());
+    }
+    if signature.is_empty() {
+        return Err("the licence request could not be signed".into());
+    }
+    let client = reqwest::Client::builder()
+        .user_agent("XboxGameRuntime")
+        .redirect(reqwest::redirect::Policy::none())
+        .connect_timeout(Duration::from_secs(10))
+        .timeout(HTTP_TIMEOUT)
+        .build()
+        .map_err(|e| e.to_string())?;
+    let mut response = client
+        .post(url)
+        .header("Authorization", authorization)
+        .header("Signature", signature)
+        .header("Content-Type", "application/json; charset=UTF-8")
+        .header("Cache-Control", "no-cache")
+        .body(body)
+        .send()
+        .await
+        .map_err(|e| format!("the licence service could not be reached ({})", e.without_url()))?;
+    let status = response.status();
+    if status != reqwest::StatusCode::OK {
+        // Status only: the body can carry account details.
+        return Err(format!("the licence service answered HTTP {status}"));
+    }
+    if response.content_length().is_some_and(|n| n > MAX_RESPONSE as u64) {
+        return Err("the licence service's answer is too large".into());
+    }
+    let mut bytes = Vec::new();
+    while let Some(chunk) = response.chunk().await.map_err(|e| e.without_url().to_string())? {
+        if chunk.len() > MAX_RESPONSE - bytes.len() {
+            return Err("the licence service's answer is too large".into());
+        }
+        bytes.extend_from_slice(&chunk);
+    }
+    parse_response(&bytes)
+}
+
+pub(super) async fn fetch(context: &SimpleContext, xml: &[u8]) -> Result<String, String> {
+    let text = std::str::from_utf8(xml).map_err(|_| "the licence request is not UTF-8".to_string())?;
+    let req: LicenseTokenIpcRequest =
+        quick_xml::de::from_str(text).map_err(|e| format!("the licence request does not parse: {e}"))?;
+    check(&req, crate::binding::store_product().as_deref())?;
+    let bytes = body(&req)?;
+    tracing::info!(
+        "Licence token for {} and {} add-on(s)",
+        req.parent_product_id,
+        req.product_ids.ids.len()
+    );
+    // The same signed-XSTS path the title's own requests take, for this exact body.
+    let auth = super::xml::xsts_response(
+        context,
+        &XSTSTokenRequest {
+            url: URL.into(),
+            relying_party: String::new(),
+            method: "POST".into(),
+            body_base64: STANDARD.encode(&bytes),
+            title_id: req.title_id.clone(),
+            title_client_id: req.title_client_id.clone(),
+        },
+    )
+    .await
+    .map_err(|e| format!("no XSTS token for the licence service: {e}"))?;
+    let token = post(URL, bytes, &auth.token, &auth.signature).await?;
+    tracing::info!("Licence token issued ({} bytes)", token.len());
+    Ok(token)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use xodus::models::xgameruntime::xuser::LicenseProductIds;
+
+    fn request(parent: &str, ids: &[&str], custom: &str) -> LicenseTokenIpcRequest {
+        LicenseTokenIpcRequest {
+            parent_product_id: parent.into(),
+            product_ids: LicenseProductIds { ids: ids.iter().map(|s| s.to_string()).collect() },
+            custom_base64: STANDARD.encode(custom),
+            title_id: "2079757188".into(),
+            title_client_id: "000000004CE146F7".into(),
+        }
+    }
+
+    #[test]
+    fn the_body_is_what_the_licence_service_takes() {
+        let bytes = body(&request("9TESTSTORE01", &["9TESTADDON00", "9TESTADDON01"], "nonce-1")).unwrap();
+        let value: serde_json::Value = serde_json::from_slice(&bytes).unwrap();
+        assert_eq!(value["parentProductId"], "9TESTSTORE01");
+        assert_eq!(value["enforceSellableBy"], true);
+        // a string holding a JSON array, as Windows sends it
+        assert_eq!(value["relatedProductIds"], "[\"9TESTADDON00\",\"9TESTADDON01\"]");
+        assert_eq!(value["customDeveloperString"], "nonce-1");
+        assert!(body(&request("9TESTSTORE01", &[], "")).is_err());
+    }
+
+    #[test]
+    fn only_the_bound_game_and_store_ids_are_asked_for() {
+        assert!(check(&request("9TESTSTORE01", &["9TESTADDON00"], "x"), Some("9teststore01")).is_ok());
+        assert!(check(&request("9TESTSTORE01", &["9TESTADDON00"], "x"), None).is_ok());
+        assert!(check(&request("9OTHERGAME00", &["9TESTADDON00"], "x"), Some("9TESTSTORE01")).is_err());
+        assert!(check(&request("9TESTSTORE01", &["not an id"], "x"), None).is_err());
+        assert!(check(&request("../etc", &[], "x"), None).is_err());
+    }
+
+    #[test]
+    fn only_a_well_formed_token_is_handed_over() {
+        assert_eq!(parse_response(br#"{"licenseToken":"aaa.bbb.ccc"}"#).unwrap(), "aaa.bbb.ccc");
+        assert!(parse_response(br#"{"licenseToken":""}"#).is_err());
+        assert!(parse_response(br#"{"licenseToken":"a b"}"#).is_err());
+        assert!(parse_response(b"<html>").is_err());
+    }
+}
