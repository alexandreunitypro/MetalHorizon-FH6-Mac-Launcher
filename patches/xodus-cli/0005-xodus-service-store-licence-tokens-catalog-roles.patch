+    let mut b = [0u8; 4];
+    tokio::time::timeout(std::time::Duration::from_secs(5), socket.read_exact(&mut b))
+        .await
+        .map_err(|_| std::io::Error::from(std::io::ErrorKind::TimedOut))??;
+    Ok(u32::from_le_bytes(b))
+}
+
+async fn write_u32s(socket: &mut tokio::net::UnixStream, values: &[u32]) -> tokio::io::Result<()> {
+    let bytes: Vec<u8> = values.iter().flat_map(|v| v.to_le_bytes()).collect();
+    socket.write_all(&bytes).await
+}
