+///
+/// The game only runs after `xodus-cli run` got its package licence from Microsoft for this account (it cannot decrypt
+/// its files otherwise), so for the bound game the answer is whether that account is still signed in. Any other
+/// product is not licensed through this path, as in Ferestre's service.
+async fn entitlement(socket: &mut tokio::net::UnixStream, context: &SimpleContext) -> tokio::io::Result<()> {
+    let version = read_u32(socket).await?;
+    let length = read_u32(socket).await?;
+    if version != 1 || length != 12 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            format!("entitlement request version {version}, length {length}"),
+        ));
+    }
+    let mut product = [0u8; 12];
+    tokio::time::timeout(std::time::Duration::from_secs(5), socket.read_exact(&mut product))
+        .await
+        .map_err(|_| std::io::Error::from(std::io::ErrorKind::TimedOut))??;
+    let product = String::from_utf8_lossy(&product).to_string();
+    let bound = crate::binding::store_product();
+    let licensed = bound.as_deref().is_some_and(|b| b.eq_ignore_ascii_case(&product)) && signed_in(context);
+    match &bound {
+        None => tracing::info!("Licence query for {product}: no game bound (XODUS_STORE_PRODUCT), answering no"),
+        Some(_) => tracing::debug!("Licence query for {product}: {}", if licensed { "licensed" } else { "not licensed" }),
+    }
+    write_u32s(socket, &[1, licensed as u32]).await
+}
+
