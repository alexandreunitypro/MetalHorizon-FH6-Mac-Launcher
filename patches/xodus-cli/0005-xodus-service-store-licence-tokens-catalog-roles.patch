+/// Account roles, version 1: `[1, store signed in, player signed in, same account]`. One account owns and plays here.
+async fn roles(socket: &mut tokio::net::UnixStream, context: &SimpleContext) -> tokio::io::Result<()> {
+    let version = read_u32(socket).await?;
+    if version != 1 {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidData,
+            format!("account roles version {version}"),
+        ));
+    }
+    let on = signed_in(context) as u32;
+    write_u32s(socket, &[1, on, on, on]).await
