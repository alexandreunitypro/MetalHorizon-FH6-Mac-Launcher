diff -ruN a/crates/xodus-service/src/device.rs b/crates/xodus-service/src/device.rs
--- a/crates/xodus-service/src/device.rs	1970-01-01 01:00:00
+++ b/crates/xodus-service/src/device.rs	2026-11-20 13:27:02
@@ -0,0 +1,85 @@
+//! The device ticket, renewed when Microsoft refuses it.
+//!
+//! Every Xbox request starts with Microsoft's ticket exchange, which takes this Mac's device ticket along with the
+//! user's. When Microsoft stops accepting the device ticket (it aged, or was revoked), every request fails, the game
+//! says Initialization Failed (E:0-c2-4), and signing in again does not help: the user was never the problem. Ferestre
+//! renews a rejected device ticket once from the device key the sign-in stored (icex/xodus e35bde1); so does this
+//! service, without any user step. The renewed ticket is kept in memory for this service only: nothing is written to
+//! the Keychain, so no new macOS window can appear in the middle of a game.
+use xodus::models::secrets::{LegacyToken, Token};
+use xodus::models::soap::BodyContent;
+use xodus::tokens::TokenManager;
+
+static RENEWED: std::sync::RwLock<Option<LegacyToken>> = std::sync::RwLock::new(None);
+
+/// The device ticket to use: the one renewed in this service, else the one it started with.
+pub fn current(started_with: &LegacyToken) -> LegacyToken {
+    RENEWED
+        .read()
+        .ok()
+        .and_then(|renewed| renewed.clone())
+        .unwrap_or_else(|| started_with.clone())
+}
+
+/// Whether a failed sign-in is worth one more try with a renewed device ticket: Microsoft's ticket exchange (the step
+/// that takes the device ticket) refused or failed. Xbox's own refusals of the account (XErr) are not.
+pub fn worth_renewing(error: &str) -> bool {
+    error.contains("ticket exchange")
+}
+
+/// A fresh device ticket from Microsoft, with the device key the sign-in stored: no user step, nothing written.
+pub async fn renew(client: &reqwest::Client, tokens: &TokenManager) -> Result<LegacyToken, String> {
+    let license = tokens
+        .get_device_license()
+        .map_err(|_| "the stored device credentials cannot be read".to_string())?;
+    let sp = xodus::licensing::splicense::SPLicense::parse_base64(&license.splicense)
+        .map_err(|_| "the stored device licence is invalid".to_string())?;
+    let state = sp
+        .clep_sign_state
+        .ok_or_else(|| "the stored device licence has no signing key".to_string())?;
+    let key = xodus::licensing::utils::parse_bcrypt_rsa_private(&state.get_rsa_key())
+        .map_err(|_| "the stored device key is invalid".to_string())?;
+    let answer = xodus::api::live::authenticate_device(client, license.username, key)
+        .await
+        .map_err(|err| format!("Microsoft did not renew the device ticket: {err}"))?;
+    let BodyContent::RequestSecurityTokenResponse(response) = answer.body.body else {
+        return Err("Microsoft answered without a device ticket".into());
+    };
+    let Token::Legacy(ticket) = (*response).into() else {
+        return Err("Microsoft answered with a device ticket of another kind".into());
+    };
+    if ticket.binary_secret.is_none() {
+        return Err("the renewed device ticket has no signing secret".into());
+    }
+    if let Ok(mut renewed) = RENEWED.write() {
+        *renewed = Some(ticket.clone());
+    }
+    tracing::info!("Device ticket renewed (valid until {})", ticket.lifetime.expires);
+    Ok(ticket)
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn only_the_ticket_exchange_is_worth_a_renewed_device_ticket() {
+        assert!(super::worth_renewing(
+            "Microsoft refused the saved sign-in (a fault on the ticket exchange): sign in again"
+        ));
+        assert!(super::worth_renewing("the Microsoft ticket exchange failed: error sending request"));
+        assert!(!super::worth_renewing("the XSTS token: HTTP status client error (401 Unauthorized)"));
+    }
+
+    #[test]
+    fn without_a_renewal_the_starting_ticket_is_used() {
+        use xodus::models::secrets::LegacyToken;
+        use xodus::models::soap::Timestamp;
+        let start = LegacyToken {
+            key_name: None,
+            token: "start".into(),
+            binary_secret: None,
+            tpm_key: None,
+            lifetime: Timestamp { id: None, created: String::new(), expires: String::new() },
+        };
+        assert_eq!(super::current(&start).token, "start");
+    }
+}
