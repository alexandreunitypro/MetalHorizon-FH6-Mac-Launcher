+pub(super) async fn handle(socket: &mut tokio::net::UnixStream, context: &SimpleContext) -> tokio::io::Result<()> {
+    let mut head = [0u8; 8];
+    tokio::time::timeout(Duration::from_secs(5), socket.read_exact(&mut head))
+        .await
+        .map_err(|_| std::io::Error::from(std::io::ErrorKind::TimedOut))??;
+    let version = u32::from_le_bytes(head[..4].try_into().unwrap());
+    let asked = u32::from_le_bytes(head[4..].try_into().unwrap());
+    let answer = if version != 1 {
+        Err(format!("gamer picture request version {version}"))
+    } else {
+        tokio::time::timeout(Duration::from_secs(25), fetch(context, pixels(asked)))
+            .await
+            .unwrap_or_else(|_| Err("the gamer picture did not come in 25 s".into()))
+    };
+    let mut out = Vec::new();
+    out.extend(MAGIC.to_le_bytes());
+    match answer {
+        Ok(png) => {
+            out.extend(0u32.to_le_bytes());
+            out.extend((png.len() as u32).to_le_bytes());
+            out.extend(png.iter());
+        }
+        Err(e) => {
+            tracing::warn!("No gamer picture, the game keeps a plain one: {e}");
+            out.extend(1u32.to_le_bytes());
+            out.extend(0u32.to_le_bytes());
+        }
+    }
+    socket.write_all(&out).await
+}
