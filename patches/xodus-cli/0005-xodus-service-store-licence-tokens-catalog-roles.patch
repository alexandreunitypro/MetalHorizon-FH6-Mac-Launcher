+//! What the signed-in account owns: the Microsoft Store's collections.
+//!
+//! The game asks the runtime which of its products the player owns (its add-ons: the VIP membership, the Car Pass,
+//! car packs, expansions) and, until MetalHorizon 1.1.1, the answer was always "none": the in-game store priced what
+//! the player had bought, and VIP was not seen (issue #18). The request is the one Ferestre's xodus-cli makes for
+//! its owned-title listing (icex/xodus, crates/xodus-cli/src/commands/collections.rs, checked there against the
+//! service): `POST collections.mp.microsoft.com/v6.0/collections/query`, the caller authenticated with an MSA device
+//! ticket and the beneficiary with an MSA user ticket, both for www.microsoft.com under MBI_SSL, the user ticket in
+//! the `t=...&p=` form. Only entitlements whose status is Active count. The answer is kept for ten minutes.
+//!
+//! What a player owns of the game is then resolved against the public catalog (`family`): an add-on counts when its
+//! catalog entry names the game as its parent ("addOnParent"), and an edition or bundle the account owns (Deluxe,
+//! Premium, an add-ons bundle) counts with everything it contains ("BundledSkus"), whether the collection lists those
+//! items one by one or not. So the VIP membership and the Car Pass of a Premium Edition are owned to the game.
+use std::collections::HashSet;
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use xodus::models::live::ExchangeUserTokenOutcome;
+use xodus::models::secrets::Token;
+use xodus::models::soap;
+
+use crate::simple_context::SimpleContext;
+
+const QUERY: &str = "https://collections.mp.microsoft.com/v6.0/collections/query";
+const HOSTING_APP: &str = "{d6d5a677-0872-4ab0-9442-bb792fce85c5}";
+const TARGET: &str = "www.microsoft.com";
+const KEEP: Duration = Duration::from_secs(600);
+const MAX_PAGES: usize = 20;
+
+static CACHE: Mutex<Option<(Instant, Arc<Owned>)>> = Mutex::new(None);
+static FAMILY: Mutex<Option<(Instant, String, Arc<HashSet<String>>)>> = Mutex::new(None);
+/// Catalog entries looked up for one resolution, at most (20 to a request).
+const MAX_LOOKUPS: usize = 400;
+
+/// The account's active entitlements (12-character Store IDs, upper case), and those of them that are not games or
+/// apps, which may be add-ons of the game.
+#[derive(Default)]
+pub(super) struct Owned {
+    pub(super) ids: HashSet<String>,
+    pub(super) addons: HashSet<String>,
+}
+
+/// The user ticket as collections takes it: `d=<ticket>` becomes `t=<ticket>&p=` (Ferestre's store_ticket).
+pub(super) fn user_ticket(ticket: String) -> String {
+    match ticket.strip_prefix("d=") {
+        Some(value) if !value.is_empty() => {
+            if value.contains("&p=") { format!("t={value}") } else { format!("t={value}&p=") }
+        }
+        _ => ticket,
+    }
+}
+
+/// The 12-character Store IDs of the active entitlements in one page of the answer, each with whether it may be an
+/// add-on (its kind is not Game or Application, or not given), and the page's continuation token.
+pub(super) fn page(text: &str) -> Result<(Vec<(String, bool)>, Option<String>), String> {
+    let value: serde_json::Value =
+        serde_json::from_str(text).map_err(|_| "the collections answer is not JSON".to_string())?;
+    let ids = value["items"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .filter(|item| item["status"].as_str().is_none_or(|s| s.eq_ignore_ascii_case("Active")))
+        .filter_map(|item| {
+            let id = item["productId"].as_str()?;
+            // the kind, under either name the Store has used for it
+            let addon = item["productKind"]
+                .as_str()
+                .or(item["productType"].as_str())
+                .is_none_or(|k| !k.eq_ignore_ascii_case("Game") && !k.eq_ignore_ascii_case("Application"));
+            Some((id, addon))
+        })
+        .filter(|(id, _)| id.len() == 12 && id.bytes().all(|c| c.is_ascii_alphanumeric()))
+        .map(|(id, addon)| (id.to_ascii_uppercase(), addon))
+        .collect();
+    let next = value["continuationToken"].as_str().filter(|t| !t.is_empty()).map(str::to_string);
+    Ok((ids, next))
+}
+
+fn correlation_vector() -> String {
+    format!("{}.0", uuid::Uuid::new_v4().simple())
+}
+
+/// The account's active entitlements. Kept for ten minutes.
+pub(super) async fn owned(context: &SimpleContext) -> Result<Arc<Owned>, String> {
+    if let Ok(cache) = CACHE.lock()
+        && let Some((at, set)) = cache.as_ref()
+        && at.elapsed() < KEEP
+    {
+        return Ok(set.clone());
+    }
+    let device = context.device_token.clone().ok_or("no device ticket")?;
+    let issued = xodus::api::live::exchange_device_token(
+        &context.client,
+        device.clone(),
+        HOSTING_APP.into(),
+        TARGET.into(),
+        Some(soap::PolicyReference::mbi_ssl()),
+    )
+    .await
+    .map_err(|e| format!("the Store's device ticket: {e:?}"))?;
+    let Token::Compact(auth) = Token::from(issued) else {
+        return Err("the Store's device ticket came back in the legacy form".into());
+    };
+    let Ok(Token::Legacy(user_legacy)) = context.tokens().get_user_sts_token() else {
+        return Err("no signed-in user ticket".into());
+    };
+    let user = context.tokens().get_user().map_err(|e| format!("no stored user: {e}"))?;
+    let outcome = xodus::api::live::exchange_user_token(
+        &context.client,
+        user_legacy,
+        user.username,
+        device,
+        None,
+        Some("Silent".to_string()),
+        HOSTING_APP.into(),
+        &[(TARGET.to_owned(), Some(soap::PolicyReference::mbi_ssl()))],
+    )
+    .await
+    .map_err(|e| format!("the Store's user ticket: {e:?}"))?;
+    let token: Token = match outcome {
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponseCollection(mut c))
+            if !c.security_tokens.is_empty() => c.security_tokens.remove(0).into(),
+        ExchangeUserTokenOutcome::Issued(soap::BodyContent::RequestSecurityTokenResponse(t)) => (*t).into(),
+        _ => return Err("Microsoft refused the Store's user ticket".into()),
+    };
+    let Token::Compact(ticket) = token else {
+        return Err("the Store's user ticket came back in the legacy form".into());
+    };
+    let identity = user_ticket(ticket);
+
+    let mut set = Owned::default();
+    let mut continuation: Option<String> = None;
+    for _ in 0..MAX_PAGES {
+        let mut body = serde_json::json!({
+            "maxPageSize": 100,
+            "excludeDuplicates": true,
+            "productTypes": ["Application", "Durable", "Game", "Pass"],
+            "beneficiaries": [{ "identitytype": "msa", "identityValue": identity, "localTicketReference": "1" }],
+        });
+        if let Some(token) = &continuation {
+            body["continuationToken"] = serde_json::Value::String(token.clone());
+        }
+        let response = context
+            .client
+            .post(QUERY)
+            .header("Authorization", &auth)
+            .header("Content-Type", "application/json")
+            .header("MS-CV", correlation_vector())
+            .body(body.to_string())
+            .timeout(Duration::from_secs(20))
+            .send()
+            .await
+            .map_err(|e| format!("the Store's collections could not be reached ({})", e.without_url()))?;
+        let status = response.status();
+        let text = response.text().await.unwrap_or_default();
+        if !status.is_success() {
+            return Err(format!("the Store's collections answered HTTP {status}"));
+        }
+        let (ids, next) = page(&text)?;
+        for (id, addon) in ids {
+            if addon {
+                set.addons.insert(id.clone());
+            }
+            set.ids.insert(id);
+        }
+        continuation = next;
+        if continuation.is_none() {
+            break;
+        }
+    }
+    tracing::info!("The account owns {} Store products (collections)", set.ids.len());
+    let set = Arc::new(set);
+    if let Ok(mut cache) = CACHE.lock() {
+        *cache = Some((Instant::now(), set.clone()));
+    }
+    Ok(set)
+}
+
+fn related(entry: &serde_json::Value) -> impl Iterator<Item = (&str, &str)> {
+    entry["MarketProperties"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .flat_map(|m| m["RelatedProducts"].as_array().into_iter().flatten())
+        .filter_map(|r| Some((r["RelatedProductId"].as_str()?, r["RelationshipType"].as_str()?)))
+}
+
+/// The game's editions: the bundles its catalog entry names ("Bundle").
+pub(super) fn editions(parent_entry: &serde_json::Value) -> HashSet<String> {
+    related(parent_entry)
+        .filter(|(_, kind)| kind.eq_ignore_ascii_case("Bundle"))
+        .map(|(id, _)| id.to_ascii_uppercase())
+        .collect()
+}
+
+/// Whether a catalog entry is an add-on of `parent` ("addOnParent").
+pub(super) fn is_addon_of(entry: &serde_json::Value, parent: &str) -> bool {
+    related(entry).any(|(id, kind)| kind.eq_ignore_ascii_case("addOnParent") && id.eq_ignore_ascii_case(parent))
+}
+
+/// What a bundle contains: the products of its SKUs' BundledSkus.
+pub(super) fn bundled(entry: &serde_json::Value) -> HashSet<String> {
+    entry["DisplaySkuAvailabilities"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .flat_map(|d| d["Sku"]["Properties"]["BundledSkus"].as_array().into_iter().flatten())
+        .filter_map(|b| b["BigId"].as_str())
+        .filter(|id| id.len() == 12 && id.bytes().all(|c| c.is_ascii_alphanumeric()))
+        .map(|id| id.to_ascii_uppercase())
+        .collect()
+}
+
+/// The game's add-ons the account owns: those it owns outright (their catalog entry names the game as parent) and
+/// those an owned edition or bundle contains. The game itself and its editions are not in the answer. Kept for ten
+/// minutes; what could not be looked up is left out, said in the log.
+pub(super) async fn family(parent: &str, owned: &Owned) -> Arc<HashSet<String>> {
+    let parent = parent.to_ascii_uppercase();
+    let mut fingerprint: Vec<&String> = owned.ids.iter().collect();
+    fingerprint.sort();
+    let key = format!("{parent}:{}", fingerprint.iter().map(|s| s.as_str()).collect::<Vec<_>>().join(","));
+    if let Ok(cache) = FAMILY.lock()
+        && let Some((at, k, set)) = cache.as_ref()
+        && *k == key
+        && at.elapsed() < KEEP
+    {
+        return set.clone();
+    }
+    let editions = match super::catalog::relationships(vec![parent.clone()]).await {
+        Ok(entries) => entries.first().map(editions).unwrap_or_default(),
+        Err(e) => {
+            tracing::warn!("The game's editions could not be looked up: {e}");
+            HashSet::new()
+        }
+    };
+    let mut lookup: Vec<String> = owned
+        .addons
+        .iter()
+        .chain(editions.iter().filter(|e| owned.ids.contains(*e)))
+        .filter(|id| **id != parent)
+        .cloned()
+        .collect();
+    lookup.sort();
+    lookup.dedup();
+    if lookup.len() > MAX_LOOKUPS {
+        tracing::warn!("{} owned products to look up; only the first {MAX_LOOKUPS} are", lookup.len());
+        lookup.truncate(MAX_LOOKUPS);
+    }
+    let mut mine = HashSet::new();
+    for chunk in lookup.chunks(200) {
+        match super::catalog::relationships(chunk.to_vec()).await {
+            Ok(entries) => {
+                for entry in &entries {
+                    let id = entry["ProductId"].as_str().unwrap_or_default().to_ascii_uppercase();
+                    let edition = editions.contains(&id);
+                    if edition || is_addon_of(entry, &parent) {
+                        if !edition {
+                            mine.insert(id);
+                        }
+                        mine.extend(bundled(entry));
+                    }
+                }
+            }
+            Err(e) => {
+                tracing::warn!("Owned products could not be looked up in the catalog: {e}");
+                break;
+            }
+        }
+    }
+    mine.remove(&parent);
+    for edition in &editions {
+        mine.remove(edition);
+    }
+    tracing::info!("The account owns {} of the game's add-ons", mine.len());
+    let mine = Arc::new(mine);
+    if let Ok(mut cache) = FAMILY.lock() {
+        *cache = Some((Instant::now(), key, mine.clone()));
+    }
+    mine
+}
