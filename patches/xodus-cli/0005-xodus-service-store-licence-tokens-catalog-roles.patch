+    if bytes.len() > MAX_IMAGE {
+        return Err(format!("the image service answered {} bytes ({kind}), more than a picture", bytes.len()));
+    }
+    let png = as_png(&bytes, px).map_err(|e| format!("{e}; {kind}"))?;
+    if !is_png(&bytes) {
+        tracing::info!("Gamer picture converted to PNG ({kind}, {} bytes)", bytes.len());
+    }
+    let bytes = Arc::new(png);
+    if let Ok(mut cache) = CACHE.lock() {
+        cache.get_or_insert_with(HashMap::new).insert(px, bytes.clone());
+    }
+    tracing::info!("Gamer picture fetched ({px} px, {} bytes)", bytes.len());
+    Ok(bytes)
+}
