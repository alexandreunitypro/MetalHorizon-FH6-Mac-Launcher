+        request = request.header("Signature", &auth.signature);
+    }
+    let response = request.send().await.map_err(|e| format!("the profile could not be reached ({})", e.without_url()))?;
+    if !response.status().is_success() {
+        return Err(format!("the profile service answered HTTP {}", response.status()));
+    }
+    let url = picture_url(&response.text().await.unwrap_or_default(), px)?;
+    let image = context
+        .client
+        .get(&url)
+        .timeout(Duration::from_secs(15))
+        .send()
+        .await
+        .map_err(|e| format!("the picture could not be fetched ({})", e.without_url()))?;
