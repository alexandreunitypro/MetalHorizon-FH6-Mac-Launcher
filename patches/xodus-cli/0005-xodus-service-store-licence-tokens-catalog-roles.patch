+    fn only_the_bound_game_and_store_ids_are_asked_for() {
+        assert!(check(&request("9TESTSTORE01", &["9TESTADDON00"], "x"), Some("9teststore01")).is_ok());
+        assert!(check(&request("9TESTSTORE01", &["9TESTADDON00"], "x"), None).is_ok());
+        assert!(check(&request("9OTHERGAME00", &["9TESTADDON00"], "x"), Some("9TESTSTORE01")).is_err());
+        assert!(check(&request("9TESTSTORE01", &["not an id"], "x"), None).is_err());
+        assert!(check(&request("../etc", &[], "x"), None).is_err());
