 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn progress_lines_count_only_the_files_fetched() {
+        let t0 = Instant::now();
+        let mut lines = ProgressLines::default();
+        // nothing before the files to fetch are known
+        assert_eq!(lines.advance(5_000, t0), None);
+        assert_eq!(lines.finish(5_000), None);
+        // 5000 bytes of metadata already read, then 1 GB of files
+        assert_eq!(lines.start(5_000, 1_000_000_000, t0), "progress 0 1000000000");
+        // at most twice a second
+        assert_eq!(lines.advance(10_000, t0 + Duration::from_millis(100)), None);
+        assert_eq!(
+            lines.advance(250_005_000, t0 + Duration::from_millis(600)),
+            Some("progress 250000000 1000000000".to_owned())
+        );
+        assert_eq!(lines.advance(260_005_000, t0 + Duration::from_millis(900)), None);
+        // the last line always, never past the total
+        assert_eq!(lines.finish(2_000_000_000), Some("progress 1000000000 1000000000".to_owned()));
+    }
+
+    #[test]
+    fn progress_lines_nothing_to_fetch() {
+        let mut lines = ProgressLines::default();
+        assert_eq!(lines.start(42, 0, Instant::now()), "progress 0 0");
+        assert_eq!(lines.finish(42), Some("progress 0 0".to_owned()));
+    }
+}
