@@ -222,7 +303,12 @@ where
         url,
         tx,
     )
-    .await
+    .await;
+    // the last line before the process exits (the channel is in order: every byte counted is in it)
+    let (ack, acked) = tokio::sync::oneshot::channel();
+    if tx.send(ProgressEvent::Done { ack }).await.is_ok() {
+        acked.await.ok();
+    }
 }
 
