 use tokio::fs::{File, OpenOptions};
@@ -28,6 +30,68 @@ enum ProgressEvent {
     Finished { id: usize },
     UpdateRemaining { name: String, total: u64 },
     UpdateStatus { name: String },
+    /// The download is over: the last progress line is written, then `ack` answers.
+    Done { ack: tokio::sync::oneshot::Sender<()> },
+}
+
+/// Progress for a launcher (XODUS_PROGRESS=lines). indicatif draws nothing when the output is a pipe or a file, so a
+/// launcher reading it got no progress at all. In this mode the bars are hidden and stdout gets
+/// `progress <bytes done> <bytes total>`: once when the files to fetch are known (done 0), at most twice a second
+/// while they download, and once at the end. Only the files this run fetches count: an update or a download started
+/// again counts the files that differ from the last complete download, not the whole package.
+#[derive(Default)]
+struct ProgressLines {
+    base: u64,
+    total: Option<u64>,
+    last: Option<Instant>,
+}
+
+impl ProgressLines {
+    const INTERVAL: Duration = Duration::from_millis(500);
+
+    fn enabled() -> bool {
+        std::env::var("XODUS_PROGRESS").is_ok_and(|v| v == "lines")
+    }
+
+    fn line(done: u64, total: u64) -> String {
+        format!("progress {done} {total}")
+    }
+
+    fn done(&self, position: u64, total: u64) -> u64 {
+        position.saturating_sub(self.base).min(total)
+    }
+
+    /// The files to fetch are known: `position` is the total bar's position then (the package's metadata).
+    fn start(&mut self, position: u64, total: u64, now: Instant) -> String {
+        self.base = position;
+        self.total = Some(total);
+        self.last = Some(now);
+        Self::line(0, total)
+    }
+
+    fn advance(&mut self, position: u64, now: Instant) -> Option<String> {
+        let total = self.total?;
+        if let Some(last) = self.last {
+            if now.duration_since(last) < Self::INTERVAL {
+                return None;
+            }
+        }
+        self.last = Some(now);
+        Some(Self::line(self.done(position, total), total))
+    }
+
+    fn finish(&self, position: u64) -> Option<String> {
+        let total = self.total?;
+        Some(Self::line(self.done(position, total), total))
+    }
+
+    fn print(line: Option<String>) {
+        if let Some(line) = line {
+            let mut out = std::io::stdout().lock();
+            writeln!(out, "{line}").ok();
+            out.flush().ok();
+        }
+    }
 }
 
