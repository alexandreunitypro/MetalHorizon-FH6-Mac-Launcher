+/// A token whose lifetime ends within `margin` (or has ended) is expired. A lifetime that does not parse is taken as
+/// valid: Microsoft says so itself when it is not.
+pub fn token_expired(token: &Token, margin: Duration) -> bool {
+    let Token::Legacy(legacy) = token else {
+        return false;
+    };
+    let Ok(expires) = chrono::DateTime::parse_from_rfc3339(legacy.lifetime.expires.trim()) else {
+        return false;
+    };
+    let margin = chrono::Duration::from_std(margin).unwrap_or_else(|_| chrono::Duration::zero());
+    expires.with_timezone(&chrono::Utc) <= chrono::Utc::now() + margin
+}
