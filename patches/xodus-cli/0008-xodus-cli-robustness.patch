+/// Up to four tries, 1, 2 then 4 s apart, for a call to Microsoft that failed on the network.
+async fn with_retries<T, E: fmt::Display>(
+    what: &str,
+    is_network: impl Fn(&E) -> bool,
+    mut call: impl AsyncFnMut() -> Result<T, E>,
+) -> Result<T, DeviceError> {
+    let mut pause = Duration::from_secs(1);
+    for attempt in 1..=4 {
+        match call().await {
+            Ok(value) => return Ok(value),
+            Err(err) if is_network(&err) && attempt < 4 => {
+                eprintln!("{what}: {err}; trying again in {} s", pause.as_secs());
+                tokio::time::sleep(pause).await;
+                pause *= 2;
+            }
+            Err(err) if is_network(&err) => return Err(DeviceError::Network(err.to_string())),
+            Err(err) => return Err(DeviceError::Refused(err.to_string())),
