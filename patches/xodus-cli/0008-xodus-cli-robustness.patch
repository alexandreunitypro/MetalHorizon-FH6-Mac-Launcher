+/// MetalHorizon: a file whose server sends nothing for this long fails (it is tried again on another mirror).
+const NO_DATA_LIMIT: tokio::time::Duration = tokio::time::Duration::from_secs(600);
+/// Tries to write a page before the error (a full disk) goes up.
+const WRITE_ATTEMPTS: u32 = 3;
+
+/// The pause before asking the server again after `failures` failures in a row: 0.5 s, doubling, at most 30 s.
+fn retry_pause(failures: u32) -> tokio::time::Duration {
+    let millis = 500u64.saturating_mul(1u64 << failures.min(10));
+    tokio::time::Duration::from_millis(millis.min(30_000))
+}
+
+#[cfg(test)]
+mod retry_pause_tests {
+    #[test]
+    fn the_pause_grows_to_thirty_seconds() {
+        let ms = |n| super::retry_pause(n).as_millis();
+        assert_eq!(ms(0), 500);
+        assert_eq!(ms(1), 1_000);
+        assert_eq!(ms(5), 16_000);
+        assert_eq!(ms(6), 30_000);
+        assert_eq!(ms(500), 30_000, "no overflow");
+    }
+}
