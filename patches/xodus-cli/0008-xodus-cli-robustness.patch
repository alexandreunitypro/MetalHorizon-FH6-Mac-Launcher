+++ b/crates/xodus-cli/src/resilience.rs	2026-11-21 21:09:52
@@ -0,0 +1,507 @@
+//! MetalHorizon: what xodus-cli does when the network, Microsoft, the Keychain or the disk misbehave
+//! (docs/XODUS-ROBUSTNESS.md in MetalHorizon). Before, each of these ended in a panic or in a loop with no end.
+
+use std::fmt;
+use std::future::Future;
+use std::io::Write;
+use std::time::{Duration, SystemTime, UNIX_EPOCH};
+
+use xodus::tokens::store::TokenStoreError;
+
+/// Why xodus-cli failed, as one word MetalHorizon reads on an `error <kind> <message>` line.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ErrorKind {
+    /// The disk has not enough room.
+    NoSpace,
+    /// The account does not own the game.
+    NotOwned,
+    /// No sign-in is saved, or Xbox no longer accepts it.
+    SignedOut,
+    /// macOS's Keychain did not let xodus read or save the sign-in.
+    Keychain,
+    /// Microsoft or the CDN could not be reached, or kept failing.
+    Network,
+    /// A folder or a file could not be made or written.
+    Disk,
+    /// The package or its licence was not what xodus expected.
+    Package,
+    /// The Mac's clock is off: Microsoft refuses its tickets.
+    Clock,
+    Other,
+}
+
+impl ErrorKind {
+    pub fn word(self) -> &'static str {
+        match self {
+            ErrorKind::NoSpace => "no-space",
+            ErrorKind::NotOwned => "not-owned",
+            ErrorKind::SignedOut => "signed-out",
+            ErrorKind::Keychain => "keychain",
+            ErrorKind::Network => "network",
+            ErrorKind::Disk => "disk",
+            ErrorKind::Package => "package",
+            ErrorKind::Clock => "clock",
+            ErrorKind::Other => "other",
+        }
+    }
+}
+
+/// An error with its kind: printed for people on stderr, and as an `error` line for MetalHorizon.
+#[derive(Debug, Clone)]
+pub struct XodusError {
+    pub kind: ErrorKind,
+    pub message: String,
+}
+
+impl XodusError {
+    pub fn new(kind: ErrorKind, message: impl Into<String>) -> Self {
+        Self {
+            kind,
+            message: message.into(),
+        }
+    }
+
+    /// What MetalHorizon reads: `error <kind> <message on one line>`.
+    pub fn line(&self) -> String {
+        format!("error {} {}", self.kind.word(), one_line(&self.message))
+    }
+
+    /// Printed once, where the run gives up.
+    pub fn report(&self) {
+        eprintln!("{}", self.message);
+        machine_line(&self.line());
+    }
+}
+
+impl fmt::Display for XodusError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.message)
+    }
+}
+
+impl std::error::Error for XodusError {}
+
+fn one_line(text: &str) -> String {
+    text.split_whitespace().collect::<Vec<_>>().join(" ")
+}
+
+// ---- lines for MetalHorizon ---------------------------------------------------------------------------------------
+
+/// MetalHorizon asks for its lines with XODUS_PROGRESS=lines; a terminal gets none of them.
+pub fn machine_lines_enabled() -> bool {
+    std::env::var("XODUS_PROGRESS").is_ok_and(|v| v == "lines")
+}
+
+/// One line on stdout, flushed at once (the app reads the log while xodus runs).
+pub fn machine_line(line: &str) {
+    if !machine_lines_enabled() {
+        return;
+    }
+    let mut out = std::io::stdout().lock();
+    writeln!(out, "{line}").ok();
+    out.flush().ok();
+}
+
+/// `status <phase>`: the step the download is at (index, licence, files, finishing, paused).
+pub fn status(phase: &str) {
+    machine_line(&format!("status {phase}"));
+}
+
+// ---- transient or final -----------------------------------------------------------------------------------------
+
+/// Whether a failure is worth another try, and after how long when the server said so.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Verdict {
+    Retry(Option<Duration>),
+    GiveUp,
+}
+
+/// 408, 425, 429 and the 5xx may pass; 400, 401, 403 and 404 will answer the same again.
+pub fn verdict_for_status(status: u16, retry_after: Option<Duration>) -> Verdict {
+    match status {
+        408 | 425 | 429 | 500..=599 => Verdict::Retry(retry_after),
+        _ => Verdict::GiveUp,
+    }
+}
+
+/// A connection that failed or timed out, or a body cut short, may pass; an answer that does not decode will not.
+pub fn verdict_for_reqwest(err: &reqwest::Error) -> Verdict {
+    if let Some(status) = err.status() {
+        return verdict_for_status(status.as_u16(), None);
+    }
+    if err.is_decode() || err.is_builder() || err.is_redirect() {
+        return Verdict::GiveUp;
+    }
+    Verdict::Retry(None)
+}
+
+/// The pause before the next try: `base` doubled at each failure, at most `cap`, less up to a quarter at random so
+/// that retries do not all land together. `jitter` is in 0..1.
+pub fn backoff_with(failures: u32, base: Duration, cap: Duration, jitter: f64) -> Duration {
+    let factor = 2u32.saturating_pow(failures.min(20));
+    let pause = base.saturating_mul(factor).min(cap);
+    pause.mul_f64(1.0 - 0.25 * jitter.clamp(0.0, 1.0))
+}
+
+pub fn backoff(failures: u32, base: Duration, cap: Duration) -> Duration {
+    backoff_with(failures, base, cap, pseudo_random())
+}
+
+fn pseudo_random() -> f64 {
+    let nanos = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.subsec_nanos())
+        .unwrap_or(0);
+    // a few rounds of xorshift on the clock's nanoseconds: enough to spread retries, nothing secret depends on it
+    let mut x = (nanos as u64) ^ 0x9E37_79B9_7F4A_7C15;
+    x ^= x << 13;
+    x ^= x >> 7;
+    x ^= x << 17;
+    (x % 10_000) as f64 / 10_000.0
+}
+
+/// `Retry-After`: seconds, or an HTTP date. At most 5 minutes: a server asking for more is answered by the app's
+/// own resume later.
+pub fn parse_retry_after(value: &str, now: SystemTime) -> Option<Duration> {
+    let value = value.trim();
+    let cap = Duration::from_secs(300);
+    if let Ok(seconds) = value.parse::<u64>() {
+        return Some(Duration::from_secs(seconds).min(cap));
+    }
+    let date = chrono::DateTime::parse_from_rfc2822(value).ok()?;
+    let then = UNIX_EPOCH + Duration::from_secs(date.timestamp().max(0) as u64);
+    Some(then.duration_since(now).unwrap_or(Duration::ZERO).min(cap))
+}
+
+fn retry_after_header(response: &reqwest::Response) -> Option<Duration> {
+    response
+        .headers()
+        .get(reqwest::header::RETRY_AFTER)
+        .and_then(|value| value.to_str().ok())
+        .and_then(|value| parse_retry_after(value, SystemTime::now()))
+}
+
+/// Runs `op` until it succeeds, `judge` says the failure is final, or `attempts` tries are spent. Each failure that
+/// is tried again is written on stderr with the pause, so the log shows what happened.
+pub async fn retry<T, E, F, Fut>(
+    what: &str,
+    attempts: u32,
+    mut op: F,
+    judge: impl Fn(&E) -> Verdict,
+) -> Result<T, E>
+where
+    F: FnMut() -> Fut,
+    Fut: Future<Output = Result<T, E>>,
+    E: fmt::Display,
+{
+    let mut failures = 0u32;
+    loop {
+        match op().await {
+            Ok(value) => return Ok(value),
+            Err(err) => {
+                failures += 1;
+                match judge(&err) {
+                    Verdict::Retry(after) if failures < attempts => {
+                        let pause = after.unwrap_or_else(|| {
+                            backoff(failures - 1, Duration::from_secs(1), Duration::from_secs(60))
+                        });
+                        eprintln!(
+                            "{what}: {err}; trying again in {:.1} s ({failures}/{attempts})",
+                            pause.as_secs_f32()
+                        );
+                        tokio::time::sleep(pause).await;
+                    }
+                    _ => return Err(err),
+                }
+            }
+        }
+    }
+}
+
+/// A request that did not give a success: its status when there was an answer, and the pause the server asked for.
+#[derive(Debug)]
+pub struct HttpFailure {
+    pub status: Option<u16>,
+    pub retry_after: Option<Duration>,
+    pub message: String,
+}
+
+impl fmt::Display for HttpFailure {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(&self.message)
+    }
+}
+
+impl HttpFailure {
+    pub fn verdict(&self) -> Verdict {
+        match self.status {
+            Some(status) => verdict_for_status(status, self.retry_after),
+            None => Verdict::Retry(None),
+        }
+    }
+
+    /// The kind for a request to Microsoft that failed for good.
+    pub fn kind(&self) -> ErrorKind {
+        match self.status {
+            None => ErrorKind::Network,
+            Some(401) | Some(403) => ErrorKind::SignedOut,
+            Some(status) if verdict_for_status(status, None) != Verdict::GiveUp => ErrorKind::Network,
+            Some(_) => ErrorKind::Package,
+        }
+    }
+}
+
+/// Sends the request `build` makes until it answers with a success (retrying the transient failures, with the
+/// server's Retry-After when it gives one).
+pub async fn send(
+    what: &str,
+    attempts: u32,
+    build: impl Fn() -> reqwest::RequestBuilder,
+) -> Result<reqwest::Response, HttpFailure> {
+    retry(
+        what,
+        attempts,
+        || async {
+            let response = build().send().await.map_err(|err| HttpFailure {
+                status: err.status().map(|s| s.as_u16()),
+                retry_after: None,
+                message: format!("{what}: {err}"),
+            })?;
+            let status = response.status();
+            if status.is_success() {
+                Ok(response)
+            } else {
+                Err(HttpFailure {
+                    status: Some(status.as_u16()),
+                    retry_after: retry_after_header(&response),
+                    message: format!("{what}: HTTP {status}"),
+                })
+            }
+        },
+        |failure: &HttpFailure| failure.verdict(),
+    )
+    .await
+}
+
+// ---- the Keychain and the saved sign-in ---------------------------------------------------------------------
+
+/// A failure to read the saved sign-in: no entry is "signed out", a refused Keychain is "keychain".
+pub fn token_error(err: &TokenStoreError, what: &str) -> XodusError {
+    match err {
+        TokenStoreError::NotFound => XodusError::new(
+            ErrorKind::SignedOut,
+            format!("No Xbox sign-in is saved ({what}): sign in with Microsoft first."),
+        ),
+        TokenStoreError::Keychain(err) => XodusError::new(
+            ErrorKind::Keychain,
+            format!(
+                "macOS's Keychain did not let xodus use the Xbox sign-in ({what}: {err}). When macOS asks about the \
+                 \"Xodus Service\" item, choose Always Allow, then try again."
+            ),
+        ),
+        TokenStoreError::Serde(err) => XodusError::new(
+            ErrorKind::SignedOut,
+            format!("The saved Xbox sign-in could not be read ({what}: {err}): sign in with Microsoft again."),
+        ),
+        TokenStoreError::Io(err) => XodusError::new(
+            ErrorKind::Keychain,
+            format!("The saved Xbox sign-in could not be read ({what}: {err})."),
+        ),
+    }
+}
+
+// ---- the clock ----------------------------------------------------------------------------------------------------
+
+/// How far the Mac's clock is from a server's `Date` header, in seconds (positive: the Mac is ahead).
+pub fn clock_skew(date_header: &str, now: SystemTime) -> Option<i64> {
+    let server = chrono::DateTime::parse_from_rfc2822(date_header.trim()).ok()?;
+    let now = now.duration_since(UNIX_EPOCH).ok()?.as_secs() as i64;
+    Some(now - server.timestamp())
+}
+
+/// When Microsoft refuses a ticket, a clock more than 5 minutes off is the usual cause: this says so, or None.
+pub async fn clock_note(client: &reqwest::Client) -> Option<String> {
+    let response = client
+        .head("https://licensing.mp.microsoft.com/")
+        .timeout(Duration::from_secs(10))
+        .send()
+        .await
+        .ok()?;
+    let date = response.headers().get(reqwest::header::DATE)?.to_str().ok()?;
+    let skew = clock_skew(date, SystemTime::now())?;
+    (skew.abs() > 300).then(|| {
+        format!(
+            "This Mac's clock is {} minutes {} Microsoft's: turn on Set time and date automatically in System \
+             Settings › General › Date & Time, then try again.",
+            skew.abs() / 60,
+            if skew > 0 { "ahead of" } else { "behind" }
+        )
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn statuses_worth_another_try() {
+        for status in [408, 425, 429, 500, 502, 503, 504] {
+            assert_eq!(verdict_for_status(status, None), Verdict::Retry(None), "{status}");
+        }
+        for status in [400, 401, 403, 404, 410] {
+            assert_eq!(verdict_for_status(status, None), Verdict::GiveUp, "{status}");
+        }
+        let after = Some(Duration::from_secs(7));
+        assert_eq!(verdict_for_status(429, after), Verdict::Retry(after));
+    }
+
+    #[test]
+    fn backoff_doubles_up_to_its_cap() {
+        let base = Duration::from_secs(1);
+        let cap = Duration::from_secs(60);
+        assert_eq!(backoff_with(0, base, cap, 0.0), Duration::from_secs(1));
+        assert_eq!(backoff_with(1, base, cap, 0.0), Duration::from_secs(2));
+        assert_eq!(backoff_with(5, base, cap, 0.0), Duration::from_secs(32));
+        assert_eq!(backoff_with(6, base, cap, 0.0), cap);
+        assert_eq!(backoff_with(40, base, cap, 0.0), cap, "no overflow");
+        // the random part takes at most a quarter off
+        assert_eq!(backoff_with(2, base, cap, 1.0), Duration::from_secs(3));
+        let any = backoff(3, base, cap);
+        assert!(any >= Duration::from_secs(6) && any <= Duration::from_secs(8));
+    }
+
+    #[test]
+    fn retry_after_in_seconds_or_as_a_date() {
+        let now = UNIX_EPOCH + Duration::from_secs(1_700_000_000);
+        assert_eq!(parse_retry_after("12", now), Some(Duration::from_secs(12)));
+        assert_eq!(parse_retry_after(" 4000 ", now), Some(Duration::from_secs(300)), "capped");
+        let in_a_minute = chrono::DateTime::from_timestamp(1_700_000_060, 0).unwrap().to_rfc2822();
+        assert_eq!(parse_retry_after(&in_a_minute, now), Some(Duration::from_secs(60)));
+        assert_eq!(parse_retry_after("soon", now), None);
+    }
+
+    #[test]
+    fn clock_skew_from_a_date_header() {
+        let now = UNIX_EPOCH + Duration::from_secs(1_700_000_600);
+        let server = chrono::DateTime::from_timestamp(1_700_000_000, 0).unwrap().to_rfc2822();
+        assert_eq!(clock_skew(&server, now), Some(600));
+        assert_eq!(clock_skew("Sun, 06 Nov 1994 08:49:37 GMT", UNIX_EPOCH + Duration::from_secs(784_111_777)), Some(0));
+        assert_eq!(clock_skew("yesterday", now), None);
+    }
+
+    #[test]
+    fn error_lines_for_the_app() {
+        let err = XodusError::new(ErrorKind::NoSpace, "not enough free disk space on /x:\n need 5 bytes");
+        assert_eq!(err.line(), "error no-space not enough free disk space on /x: need 5 bytes");
+        assert_eq!(err.to_string(), "not enough free disk space on /x:\n need 5 bytes");
+        assert_eq!(ErrorKind::SignedOut.word(), "signed-out");
+    }
+
+    #[test]
+    fn keychain_and_missing_sign_in() {
+        assert_eq!(token_error(&TokenStoreError::NotFound, "user token").kind, ErrorKind::SignedOut);
+        let io = std::io::Error::other("denied");
+        assert_eq!(token_error(&TokenStoreError::Io(io), "user token").kind, ErrorKind::Keychain);
+    }
+
+    #[test]
+    fn http_failures_have_a_kind() {
+        let failure = |status| HttpFailure { status, retry_after: None, message: String::new() };
+        assert_eq!(failure(None).kind(), ErrorKind::Network);
+        assert_eq!(failure(Some(503)).kind(), ErrorKind::Network);
+        assert_eq!(failure(Some(401)).kind(), ErrorKind::SignedOut);
+        assert_eq!(failure(Some(404)).kind(), ErrorKind::Package);
+        assert_eq!(failure(None).verdict(), Verdict::Retry(None));
+    }
+
+    /// A server on 127.0.0.1 answering each connection with the next of `answers` (raw HTTP), then closing.
+    fn local_server(answers: Vec<&'static str>) -> (String, std::thread::JoinHandle<usize>) {
+        use std::io::{Read, Write};
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let url = format!("http://{}/", listener.local_addr().unwrap());
+        let handle = std::thread::spawn(move || {
+            let mut served = 0;
+            for answer in answers {
+                let (mut stream, _) = listener.accept().unwrap();
+                let mut request = [0u8; 4096];
+                let _ = stream.read(&mut request);
+                stream.write_all(answer.as_bytes()).unwrap();
+                served += 1;
+            }
+            served
+        });
+        (url, handle)
+    }
+
+    #[tokio::test]
+    async fn send_waits_as_the_server_asks_then_succeeds() {
+        let (url, server) = local_server(vec![
+            "HTTP/1.1 503 Service Unavailable\r\nRetry-After: 0\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
+            "HTTP/1.1 429 Too Many Requests\r\nRetry-After: 1\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
+            "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nok",
+        ]);
+        let client = reqwest::Client::new();
+        let started = std::time::Instant::now();
+        let response = send("test", 5, || client.get(&url)).await.expect("the third answer is a success");
+        assert_eq!(response.text().await.unwrap(), "ok");
+        assert!(started.elapsed() >= Duration::from_millis(900), "Retry-After: 1 was respected");
+        assert_eq!(server.join().unwrap(), 3);
+    }
+
+    #[tokio::test]
+    async fn send_gives_up_at_once_on_a_final_status() {
+        let (url, server) = local_server(vec![
+            "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
+        ]);
+        let client = reqwest::Client::new();
+        let failure = send("test", 5, || client.get(&url)).await.expect_err("404 is final");
+        assert_eq!(failure.status, Some(404));
+        assert_eq!(failure.kind(), ErrorKind::Package);
+        assert_eq!(server.join().unwrap(), 1, "not asked again");
+    }
+
+    #[tokio::test]
+    async fn retry_stops_on_success_or_on_a_final_failure() {
+        let mut calls = 0;
+        let result: Result<u32, String> = retry(
+            "test",
+            5,
+            || {
+                calls += 1;
+                let n = calls;
+                async move { if n < 3 { Err(format!("try {n}")) } else { Ok(n) } }
+            },
+            |_| Verdict::Retry(Some(Duration::from_millis(1))),
+        )
+        .await;
+        assert_eq!(result, Ok(3));
+
+        let mut calls = 0;
+        let result: Result<u32, String> = retry(
+            "test",
+            5,
+            || {
+                calls += 1;
+                async { Err("refused".to_string()) }
+            },
+            |_| Verdict::GiveUp,
+        )
+        .await;
+        assert_eq!(result, Err("refused".to_string()));
+        assert_eq!(calls, 1, "a final failure is not tried again");
+
+        let mut calls = 0;
+        let result: Result<u32, String> = retry(
+            "test",
+            3,
+            || {
+                calls += 1;
+                async { Err("down".to_string()) }
+            },
+            |_| Verdict::Retry(Some(Duration::from_millis(1))),
+        )
+        .await;
+        assert!(result.is_err());
+        assert_eq!(calls, 3, "at most the attempts asked for");
+    }
+}
