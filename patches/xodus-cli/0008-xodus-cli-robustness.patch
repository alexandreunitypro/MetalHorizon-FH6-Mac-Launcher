+/// Tries to open (or reopen after a cut) the package over HTTP.
+const OPEN_ATTEMPTS: u32 = 6;
+
+/// MetalHorizon: opening the package, or reopening it where a cut left it, is tried again with a pause that doubles
+/// from 1 s to 30 s (six tries, about a minute), instead of the first failure ending the whole download.
+async fn open_http_stream_retrying(
+    client: reqwest::Client,
+    url: String,
+    start: Option<u64>,
+) -> std::io::Result<OpenedHttpStream> {
+    let mut pause = std::time::Duration::from_secs(1);
+    let mut attempt = 1;
+    loop {
+        match open_http_stream(client.clone(), url.clone(), start).await {
+            Ok(opened) => return Ok(opened),
+            Err(err) if attempt < OPEN_ATTEMPTS => {
+                eprintln!(
+                    "opening the package at byte {}: {err}; trying again in {} s ({attempt}/{OPEN_ATTEMPTS})",
+                    start.unwrap_or(0),
+                    pause.as_secs()
+                );
+                tokio::time::sleep(pause).await;
+                pause = (pause * 2).min(std::time::Duration::from_secs(30));
+                attempt += 1;
+            }
+            Err(err) => return Err(err),
+        }
+    }
+}
