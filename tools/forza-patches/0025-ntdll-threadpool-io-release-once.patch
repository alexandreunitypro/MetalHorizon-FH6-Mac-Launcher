+
+/* ioqueue.cs must be taken before pool->cs. The completion thread and
+ * TpReleaseIoCompletion() both observe a finished object and would otherwise
+ * each drop it. */
+
+static struct threadpool_object *tp_ioqueue_find( ULONG_PTR key )
+{
+    struct list *ptr;
+
+    LIST_FOR_EACH( ptr, &ioqueue.objs )
+    {
+        struct threadpool_object *io = LIST_ENTRY( ptr, struct threadpool_object, u.io.ioqueue_entry );
+
+        if ((ULONG_PTR)io == key)
+            return io;
+    }
+    return NULL;
+}
+
+static void tp_ioqueue_unlist( struct threadpool_object *io )
+{
+    if (!io->u.io.on_queue)
+        return;
+    list_remove( &io->u.io.ioqueue_entry );
+    io->u.io.on_queue = FALSE;
+}
+
+static void tp_ioqueue_drop_count( struct threadpool_object *io )
+{
+    if (io->u.io.detached)
+        return;
+    io->u.io.detached = TRUE;
+    assert( ioqueue.objcount );
+    if (!--ioqueue.objcount)
+        NtSetIoCompletion( ioqueue.port, 0, 0, STATUS_SUCCESS, 0 );
+}
+
+/* Caller holds ioqueue.cs and pool->cs. Returns TRUE when this caller owns
+ * the object's initial reference and must release it. */
+static BOOL tp_io_claim_release( struct threadpool_object *io )
+{
+    if (io->shutdown || !io->u.io.shutting_down)
+        return FALSE;
+    if (io->u.io.pending_count || io->u.io.skipped_count)
+        return FALSE;
+
+    io->shutdown = TRUE;
+    tp_ioqueue_unlist( io );
+    tp_ioqueue_drop_count( io );
+    return TRUE;
+}
